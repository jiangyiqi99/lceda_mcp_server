43D\u043D\u044B\u0435",Favorite:"\u041B\u044E\u0431\u0438\u043C\u044B\u0435","No Team,Please join a team or create a team first.":"\u041D\u0435\u0442 \u043A\u043E\u043C\u0430\u043D\u0434\u044B, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u0441\u044C \u043A \u043A\u043E\u043C\u0430\u043D\u0434\u0435 \u0438\u043B\u0438 \u0441\u043E\u0437\u0434\u0430\u0439\u0442\u0435 \u0441\u0432\u043E\u044E.","create a team":"\u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u0443","No follow user,Please follow your friend first.":"\u0412\u044B \u043D\u0435 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u044B \u043D\u0430 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0434\u043F\u0438\u0448\u0438\u0442\u0435\u0441\u044C \u043D\u0430 \u043D\u0435\u0433\u043E."},"Favorite Schematic Lib":"\u041B\u044E\u0431\u0438\u043C\u044B\u0435 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432","Favorite Package":"\u041B\u044E\u0431\u0438\u043C\u044B\u0435 \u043A\u043E\u0440\u043F\u0443\u0441\u0430","Favorite Module":"\u041B\u044E\u0431\u0438\u043C\u044B\u0435 \u043C\u043E\u0434\u0443\u043B\u0438",BUY:"\u041A\u0423\u041F\u0418\u0422\u042C","In Stock":"\u0412 \u043D\u0430\u043B\u0438\u0447\u0438\u0438","Out of Stock":"\u041D\u0435\u0442 \u0432 \u043D\u0430\u043B\u0438\u0447\u0438\u0438",Minimum:"\u041C\u0438\u043D\u0438\u043C\u0443\u043C",Distributor:"\u0414\u0438\u0441\u0442\u0440\u0438\u0431\u044C\u044E\u0442\u043E\u0440","Export your works":"\u042D\u043A\u0441\u043F\u043E\u0440\u0442 \u0432\u0430\u0448\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B","Export Option":"\u041E\u043F\u0446\u0438\u0438 \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0430","Active File->pdf(1:1)":"\u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u0444\u0430\u0439\u043B->PDF(1:1)","Active File->image":"\u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u0444\u0430\u0439\u043B->PNG","Active File->SVG":"\u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u0444\u0430\u0439\u043B->SVG","You can backup your easyEDA json file to your local hard disk, and import it at any time.":"\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u0443\u044E \u043A\u043E\u043F\u0438\u044E \u0432\u0430\u0448\u0435\u0433\u043E json \u0444\u0430\u0439\u043B\u0430 EasyEDA \u043D\u0430 \u0432\u0430\u0448 \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0434\u0438\u0441\u043A, \u0438 \u0438\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0435\u0433\u043E \u0432 \u043B\u044E\u0431\u043E\u0435 \u0432\u0440\u0435\u043C\u044F.",Zoom:"\u0417\u0443\u043C","Image Type":"\u0422\u0438\u043F \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F","0 means real size":"0 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u0440\u0430\u0437\u043C\u0435\u0440","Merged layer":"\u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0451\u043D\u043D\u044B\u0439 \u0441\u043B\u043E\u0439","Separated layer":"\u041E\u0442\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0439 \u0441\u043B\u043E\u0439",Export:"\u042D\u043A\u0441\u043F\u043E\u0440\u0442",Mirror:"\u0417\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u043E",TopLayer:"\u0412\u0435\u0440\u0445\u043D\u0438\u0439 \u0441\u043B\u043E\u0439",BottomLayer:"\u041D\u0438\u0436\u043D\u0438\u0439 \u0441\u043B\u043E\u0439",TopSilkLayer:"\u0412\u0435\u0440\u0445\u043D\u044F\u044F \u0448\u0435\u043B\u043A\u043E\u0433\u0440\u0430\u0444\u0438\u044F","Protractor Attributes":"\u0421\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u043F\u0440\u043E\u0442\u0440\u0430\u043A\u0442\u043E\u0440\u0430",BottomSilkLayer:"\u041D\u0438\u0436\u043D\u044F\u044F \u0448\u0435\u043B\u043A\u043E\u0433\u0440\u0430\u0444\u0438\u044F",Colour:"\u0426\u0432\u0435\u0442","Full Colour":"\u041F\u043E\u043B\u043D\u043E\u0446\u0432\u0435\u0442\u043D\u044B\u0439","Black on White":"\u0427\u0451\u0440\u043D\u043E\u0435 \u043D\u0430 \u0431\u0435\u043B\u043E\u043C","White on Black":"\u0411\u0435\u043B\u043E\u0435 \u043D\u0430 \u0447\u0451\u0440\u043D\u043E\u043C","Canvas Setting":"\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043E\u043A\u043D\u0430 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0430","Assembly Drawings":"\u041C\u043E\u043D\u0442\u0430\u0436\u043D\u044B\u0435 \u0447\u0435\u0440\u0442\u0435\u0436\u0438","Invalid file format":"\u041D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u044B\u0439 \u0444\u043E\u0440\u043C\u0430\u0442 \u0444\u0430\u0439\u043B\u0430","Failed to export file":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0444\u0430\u0439\u043B","Download now":"\u0421\u043A\u0430\u0447\u0430\u0442\u044C \u0441\u0435\u0439\u0447\u0430\u0441","Wire Width":"\u0428\u0438\u0440\u0438\u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u0430",Sheet:"\u041B\u0438\u0441\u0442","Merged sheet":"\u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0451\u043D\u043D\u044B\u0439 \u043B\u0438\u0441\u0442","Separated sheet":"\u041E\u0442\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0439 \u043B\u0438\u0441\u0442","@@exportDocument":{Size:"\u0420\u0430\u0437\u043C\u0435\u0440"},"Confirm Importing changes information":"\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u0438\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439","You can't undo this operation, Please run a DRC after this operation.":"\u0412\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u044D\u0442\u0443 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 DRC \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0439 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0438.","Apply Changes":"\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F","This is a simple DRC.":"\u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E DRC.","It just can help you to find the obvious errors":"\u041C\u043E\u0436\u0435\u0442 \u043F\u043E\u043C\u043E\u0447\u044C \u043D\u0430\u0439\u0442\u0438 \u0432\u0430\u043C \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u0435 \u043E\u0448\u0438\u0431\u043A\u0438",Configured:"\u041D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u043C\u043E\u0435","Layer Name":"\u0418\u043C\u044F \u0441\u043B\u043E\u044F",BoardOutline:"\u0413\u0440\u0430\u043D\u0438\u0446\u044B \u043F\u043B\u0430\u0442\u044B","Multi-Layer":"\u041C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u0430\u044F",Document:"\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442",Hole:"\u041E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435",DRCError:"\u041E\u0448\u0438\u0431\u043A\u0430 DRC",Setting:"\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438","Drawing area":"\u041E\u0431\u043B\u0430\u0441\u0442\u044C \u0440\u0438\u0441\u043E\u0432\u0430\u043D\u0438\u044F","Export area":"\u042D\u043A\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043E\u0431\u043B\u0430\u0441\u0442\u044C","Create Files":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u0444\u0430\u0439\u043B\u044B","Check your {0}Gerber files{1} carefully before sending them to the factory":"\u0412\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0432\u0430\u0448\u0438{0}Gerber-\u0444\u0430\u0439\u043B\u044B{1} \u043F\u0435\u0440\u0435\u0434 \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u043E\u0439 \u0438\u0445 \u043D\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E","Download free Gerber Viewer (gerbv)":"\u0421\u043A\u0430\u0447\u0430\u0442\u044C \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0439 \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0449\u0438\u043A Gerber (gerbv)","Before generating the Gerber files":"\u041F\u0435\u0440\u0435\u0434 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C Gerber-\u0444\u0430\u0439\u043B\u043E\u0432","Please check the packages size and polarity carefully.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0440\u0430\u0437\u043C\u0435\u0440\u044B \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u0432 \u0438 \u043F\u043E\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C.","Please check the DRC error in Design Manager.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 DRC-\u043E\u0448\u0438\u0431\u043A\u0438 \u0432 \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440\u0435 \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F.","Please rebuild the copper area after modifying tracks and packages.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u043C\u0435\u0434\u043D\u044B\u0435 \u043F\u043E\u043B\u0438\u0433\u0438\u043D\u044B, \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0434\u043E\u0440\u043E\u0436\u0435\u043A \u0438 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432.","After generating the Gerber file, please use the {0}Gerber Viewer{1} to check whether it conforms to the design requirements.":"\u041F\u043E\u0441\u043B\u0435 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F Gerber-\u0444\u0430\u0439\u043B\u043E\u0432, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 {0}\u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0449\u0438\u043A Gerber{1}, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C, \u0447\u0442\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0432\u0443\u044E\u0442 \u0432\u0430\u0448\u0438\u043C \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C.","Order at JLCPCB":"\u0417\u0430\u043A\u0430\u0437\u0430\u0442\u044C \u043D\u0430 JLCPCB",Item:"\u042D\u043B\u0435\u043C\u0435\u043D\u0442",Value:"\u0417\u043D\u0430\u0447\u0435\u043D\u0438\u0435",value:"\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435",Unit:"\u0415\u0434\u0438\u043D\u0438\u0446\u0430","Track Width":"\u0428\u0438\u0440\u0438\u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0438","Track to Track":"\u0414\u043E\u0440\u043E\u0436\u043A\u0430 \u043A \u0434\u043E\u0440\u043E\u0436\u043A\u0435","Track to Pad":"\u0414\u043E\u0440\u043E\u0436\u043A\u0430 \u043A \u043F\u043E\u043B\u0438\u0433\u043E\u043D\u0443","Via Hole Size":"\u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F","{0} is too small!":"{0} \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439!","Update the symbol's package":"\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u043A\u043E\u0440\u043F\u0443\u0441 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430","Invalid Package":"\u041D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u044B\u0439 \u043A\u043E\u0440\u043F\u0443\u0441","Update PCB(Synchronizing PCB from schematics)":"\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u043F\u043B\u0430\u0442\u0443 (\u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043F\u043B\u0430\u0442\u0443 \u0441\u043E \u0441\u0445\u0435\u043C\u043E\u0439)","Hotkey Setting":"\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0433\u043E\u0440\u044F\u0447\u0438\u0445 \u043A\u043B\u0430\u0432\u0438\u0448",ALL:"\u0412\u0421\u0415","Rotate selected objects":"\u041F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B","Scroll Or Move selected left":"\u041F\u0440\u043E\u043A\u0440\u0443\u0442\u0438\u0442\u044C \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435 \u0432\u043B\u0435\u0432\u043E","Scroll or Move selected right":"\u041F\u0440\u043E\u043A\u0440\u0443\u0442\u0438\u0442\u044C \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435 \u0432\u043F\u0440\u0430\u0432\u043E","Scroll or Move selected up":"\u041F\u0440\u043E\u043A\u0440\u0443\u0442\u0438\u0442\u044C \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435 \u0432\u0432\u0435\u0440\u0445","Scroll or Move selected down":"\u041F\u0440\u043E\u043A\u0440\u0443\u0442\u0438\u0442\u044C \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0435 \u0432\u043D\u0438\u0437","Cross Document Paste":"\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0438\u0437 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430","Explore & Find Components":"\u041D\u0430\u0439\u0442\u0438 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B","Select All":"\u0412\u044B\u0434\u0435\u043B\u0438\u0442\u044C \u0432\u0441\u0451","Cancel current drawing":"\u0412\u044B\u0439\u0442\