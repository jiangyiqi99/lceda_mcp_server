E\u0440\u0442\u043A\u0438","Start Value:":"\u041F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F:","Stop Value:":"\u041A\u0456\u043D\u0446\u0435\u0432\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F:","Increment:":"\u041A\u0440\u043E\u043A:","DC Transfer":"\u041F\u043E\u0441\u0442\u0456\u0439\u043D\u0435 \u0437\u043C\u0456\u0449\u0435\u043D\u043D\u044F:","Output:":"\u0412\u0438\u0445\u0456\u0434:","Source:":"\u0414\u0436\u0435\u0440\u0435\u043B\u043E:","DC op pnt":"\u0420\u043E\u0431\u043E\u0447\u0456 \u0442\u043E\u0447\u043A\u0438 \u043F\u043E \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E\u043C\u0443 \u0441\u0442\u0440\u0443\u043C\u0443","Compute the DC operating point treating capacitances as opens and inductances as shorts":"\u041E\u0431\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044F \u0442\u043E\u0447\u043E\u043A \u043F\u043E \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E\u043C\u0443 \u0441\u0442\u0440\u0443\u043C\u0443, \u0449\u043E \u0432\u0438\u043A\u043B\u044E\u0447\u0430\u044E\u0442\u044C \u043E\u0431\u0440\u0438\u0432 \u0454\u043C\u043D\u043E\u0441\u0442\u0435\u0439 \u0447\u0438 \u0437\u0430\u043A\u043E\u0440\u043E\u0447\u0435\u043D\u043D\u044F \u0456\u043D\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0435\u0439","Active File":"\u0410\u043A\u0442\u0438\u0432\u043D\u0438\u0439 \u0444\u0430\u0439\u043B","Active Project":"\u0410\u043A\u0442\u0438\u0432\u043D\u0438\u0439 \u043F\u0440\u043E\u0435\u043A\u0442","Embed it in your html files.":"\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0432 \u0432\u0430\u0448 html \u0444\u0430\u0439\u043B.","Share it by e-mail, IM, blog, etc.)":"\u041D\u0430\u0434\u0430\u0442\u0438 \u043F\u043E e-mail, ICQ, \u0431\u043B\u043E\u0433\u0430\u043C \u0442\u0430 \u0456\u043D.","BBCode (used by many online discussion forums)":"BB \u043A\u043E\u0434 (\u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F \u043D\