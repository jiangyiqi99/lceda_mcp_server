A\u043D\u0438\u0436\u043D\u044B\u0439","A2 Landscape":"A2 \u0410\u043B\u044C\u0431\u043E\u043C\u043D\u044B\u0439","A1 Portrait":"A1 \u041A\u043D\u0438\u0436\u043D\u044B\u0439","A1 Landscape":"A1 \u0410\u043B\u044C\u0431\u043E\u043C\u043D\u044B\u0439",Landscape:"\u041A\u043D\u0438\u0436\u043D\u044B\u0439",Portrait:"\u0410\u043B\u044C\u0431\u043E\u043C\u043D\u044B\u0439",solid:"\u0441\u043F\u043B\u043E\u0448\u043D\u0430\u044F",dashed:"\u043F\u0443\u043D\u043A\u0442\u0438\u0440\u043D\u0430\u044F",dotted:"\u0442\u043E\u0447\u0435\u0447\u043D\u0430\u044F","Fill Region":"\u0421\u043F\u043B\u043E\u0448\u043D\u0430\u044F \u043E\u0431\u043B\u0430\u0441\u0442\u044C",Type:"\u0422\u0438\u043F","Report error":"\u041E\u0442\u0447\u0451\u0442 \u043E\u0431 \u043E\u0448\u0438\u0431\u043A\u0435","Please give us some information to help us find the problems.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u0435 \u043D\u0430\u043C \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u043E\u0447\u044C \u043D\u0430\u043C \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443.","Cannot place parts into this document: Schematic Symbols can only be placed into a Schematic; PCB Footprints can only be placed into a PCB.":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B \u0432 \u044D\u0442\u043E\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435: \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0441\u0445\u0435\u043C \u043D\u0443\u0436\u043D\u043E \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0442\u044C \u043D\u0430 \u0441\u0445\u0435\u043C\u0435, \u0448\u0435\u043B\u043A\u043E\u0433\u0440\u0430\u0444\u0438\u044E \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u043D\u0430 \u043F\u0435\u0447\u0430\u0442\u043D\u043E\u0439 \u043F\u043B\u0430\u0442\u0435.","Save it as a favorite part":"\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043A\u0430\u043A \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442","Only logged-in users can save this component as a Favorite Part but guest (Anonymous) users can place this component into their design directly. Would you like to place this component now?":"\u0422\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0448\u0435\u0434\u0448\u0438\u0435 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0438 \u043C\u043E\u0433\u0443\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0432 \u043B\u044E\u0431\u0438\u043C\u044B\u0435, \u0430 \u0433\u043E\u0441\u0442\u0438 (\u0430\u043D\u043E\u043D\u0438\u043C\u044B) \u043C\u043E\u0433\u0443\u0442 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0440\u0430\u0437\u0443 \u0432 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442. \u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0432 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435?","Electronic circuit design - EasyEDA":"\u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u0441\u0445\u0435\u043C \u0438 \u043F\u0435\u0447\u0430\u0442\u043D\u044B\u0445 \u043F\u043B\u0430\u0442 \u043E\u043D\u043B\u0430\u0439\u043D - EasyEDA","Find libs":"\u041D\u0430\u0439\u0442\u0438 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438","My Projects":"\u041C\u043E\u0438 \u043F\u0440\u043E\u0435\u043A\u0442\u044B","My Parts":"\u041C\u043E\u0438 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B","My Modules":"\u041C\u043E\u0438 \u043C\u043E\u0434\u0443\u043B\u0438",Modules:"\u041C\u043E\u0434\u0443\u043B\u0438","SCH Modules":"\u041C\u043E\u0434\u0443\u043B\u0438 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432","PCB Modules":"\u041C\u043E\u0434\u0443\u043B\u0438 \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u0432","LCSC (Official)":"LCSC (\u041E\u0444\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439)","Favorite Parts":"\u041B\u044E\u0431\u0438\u043C\u044B\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B","Shared With Me":"\u041F\u043E\u0434\u0435\u043B\u0438\u043B\u0438\u0441\u044C \u0441\u043E \u043C\u043D\u043E\u0439",Preview:"\u041F\u0440\u0435\u0434\u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440","Preview Window":"\u041E\u043A\u043D\u043E \u043F\u0440\u0435\u0434\u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430","System Default":"\u041F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E","User Defined":"\u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C",Theme:"\u0422\u0435\u043C\u0430","Theme Setting":"\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0442\u0435\u043C\u044B",Close:"\u0417\u0430\u043A\u0440\u044B\u0442\u044C",Open:"\u041E\u0442\u043A\u0440\u044B\u0442\u044C",Collapse:"\u0421\u0432\u0435\u0440\u043D\u0443\u0442\u044C","Toggle toolbar":"\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C/\u0441\u043A\u0440\u044B\u0442\u044C \u043F\u0430\u043D\u0435\u043B\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u0432","Toggle left bar":"\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C/\u0441\u043A\u0440\u044B\u0442\u044C \u043B\u0435\u0432\u0443\u044E \u043F\u0430\u043D\u0435\u043B\u044C","Toggle right bar":"\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C/\u0441\u043A\u0440\u044B\u0442\u044C \u043F\u0440\u0430\u0432\u0443\u044E \u043F\u0430\u043D\u0435\u043B\u044C",Reload:"\u041F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C","Mouse-X":"\u041F\u043E\u0437\u0438\u0446\u0438\u044F \u043C\u044B\u0448\u0438 \u043F\u043E X","Mouse-Y":"\u041F\u043E\u0437\u0438\u0446\u0438\u044F \u043C\u044B\u0448\u0438 \u043F\u043E Y","Mouse-DX":"\u041F\u043E\u0437\u0438\u0446\u0438\u044F DX","Mouse-DY":"\u041F\u043E\u0437\u0438\u0446\u0438\u044F DY",Yes:"\u0414\u0430",No:"\u041D\u0435\u0442",OK:"\u041E\u043A",Cancel:"\u041E\u0442\u043C\u0435\u043D\u0430","Ask a question":"\u0417\u0430\u0434\u0430\u0442\u044C \u0432\u043E\u043F\u0440\u043E\u0441","Share my works":"\u041F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u043C\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u043E\u0439","Go to my page":"\u041F\u0435\u0440\u0435\u0439\u0442\u0438 \u043D\u0430 \u043C\u043E\u044E \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443","Bus entry":"\u0412\u0435\u0442\u043A\u0430 \u0448\u0438\u043D\u044B",Filter:"\u041F\u043E\u0438\u0441\u043A",Check:"\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C","Guest Project":"\u0413\u043E\u0441\u0442\u0435\u0432\u043E\u0439 \u043F\u0440\u043E\u0435\u043A\u0442","Insert into":"\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432","Insert into {site}":"\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432 {site}","Upload {site}":"\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C {site}","Copy the contents of this box into a text editor, then save the file. Paste the edited text back into this box and click Apply to update the display.":'\u0421\u043A\u043E\u043F\u0438\u0440\u0443\u0439\u0442\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u043B\u044F \u0432 \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u044B\u0439 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440, \u0437\u0430\u0442\u0435\u043C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435 \u0444\u0430\u0439\u043B. \u0412\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043E\u0442\u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0442\u0435\u043A\u0441\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u044D\u0442\u043E \u043F\u043E\u043B\u0435 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 "\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C", \u0447\u0442\u043E\u0431\u044B \u043E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435.',"EasyEDA format":"\u0424\u043E\u0440\u043C\u0430\u0442 EasyEDA","Copy the contents of this box into a text editor, then save the file with a .svg extension. You can edit it in Inkscape or open it in your browser.":"\u0421\u043A\u043E\u043F\u0438\u0440\u0443\u0439\u0442\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u043B\u044F \u0432 \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u044B\u0439 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440, \u0437\u0430\u0442\u0435\u043C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435 \u0444\u0430\u0439\u043B \u0441 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435\u043C svg. \u0412\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0435\u0433\u043E \u0432 Inkscape \u0438\u043B\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0432 \u0432\u0430\u0448\u0435\u043C \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435.","SVG format":"SVG \u0444\u043E\u0440\u043C\u0430\u0442","SVG File":"SVG-\u0444\u0430\u0439\u043B","Descript should be no more than 250 letters":"\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0442\u044C 250 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432","The file save operation has timed out. Try again and check your Internet connection.":"\u041F\u0440\u0435\u0432\u044B\u0448\u0435\u043D\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0437\u0430\u043F\u0440\u043E\u0441\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0444\u0430\u0439\u043B\u0430. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0441\u0432\u043E\u0451 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043A \u0418\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0443.","Export Netlist":"\u042D\u043A\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C Netlist",Notifications:"\u0423\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F","Please select txt or json files.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 txt \u0438\u043B\u0438 json \u0444\u0430\u0439\u043B.","Failed to read file [{file}]":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0444\u0430\u0439\u043B [{file}]","[{file}] is not a valid json file":"[{file}] \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u044B\u043C json \u0444\u0430\u0439\u043B\u043E\u043C","Invalid parameters!":"\u041D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u044B\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B!",Download:"\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C",Start:"\u041D\u0430\u0447\u0430\u0442\u044C","You have unsaved files, are you sure to log out without saving the files?":"\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u043D\u0435\u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0435 \u0444\u0430\u0439\u043B\u044B, \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u044B\u0439\u0442\u0438 \u0431\u0435\u0437 \u0438\u0445 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F?","Please use the web version to run this function.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0432\u0435\u0431-\u0432\u0435\u0440\u0441\u0438\u044E, \u0447\u0442\u043E\u0431\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u044D\u0442\u0443 \u0444\u0443\u043D\u043A\u0446\u0438\u044E.","Please save this file to you project!":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435 \u044D\u0442\u043E\u0442 \u0444\u0430\u0439\u043B \u0432 \u0432\u0430\u0448 \u043F\u0440\u043E\u0435\u043A\u0442!","nothing changed":"\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C","Delete Node":"\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0443\u0437\u0435\u043B","This layer is invisible.":"\u042D\u0442\u043E\u0442 \u0441\u043B\u043E\u0439 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0439.","Coming soon":"\u0421\u043A\u043E\u0440\u043E","No tool":"\u041D\u0435\u0442 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430","Help us translate to your language":"\u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u043D\u0430\u043C \u0441 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u043E\u043C \u043D\u0430 \u0432\u0430\u0448 \u044F\u0437\u044B\u043A",Pad:"\u041F\u043E\u043B\u0438\u0433\u043E\u043D","Via/Hole":"\u041E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435","PCB Layers":"\u0421\u043B\u043E\u0438 \u043F\u043B\u0430\u0442\u044B","Order PCB":"\u0417\u0430\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u043B\u0430\u0442\u044B",Free:"\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E",Small:"\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439",Medium:"\u0421\u0440\u0435\u0434\u043D\u0438\u0439",Big:"\u0411\u043E\u043B\u044C\u0448\u043E\u0439","Exporting as":"\u042D\u043A\u0441\u043F\u043E\u0440\u0442 \u0432","Exporting as image":"\u042D\u043A\u0441\u043F\u043E\u0440\u0442 \u0432 \u0432\u0438\u0434\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F","Exporting as {0}SVG{1} file.":"\u042D\u043A\u0441\u043F\u043E\u0440\u0442 \u0432 {0}SVG{1}-\u0444\u0430\u0439\u043B.","Exporting as pdf is recommended: pdf gives good quality printed output and a small file size.":"\u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0432 pdf: pdf \u0434\u0430\u0451\u0442 \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u0440\u0438 \u043F\u0435\u0447\u0430\u0442\u0438 \u0438 \u0438\u043C\u0435\u0435\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0440\u0430\u0437\u043C\u0435\u0440 \u0444\u0430\u0439\u043B\u0430.","Generate Fabrication File(Gerber)":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C Gerber","PenWidth-Increase":"Pen Width Increase","PCB Details":"\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E \u043F\u043B\u0430\u0442\u0435","Gerber View":"\u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 Gerber","Dimensions(Estimated)":"\u0420\u0430\u0437\u043C\u0435\u0440\u044B (\u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E)","PCB Qty":"\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u043B\u0430\u0442","Copper Weight":"\u0422\u043E\u043B\u0449\u0438\u043D\u0430 \u043C\u0435\u0434\u0438","PCB Refer Price(USD)":"\u041F\u0440\u0438\u043C\u0435\u0440\u043D\u0430\u044F \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043F\u043B\u0430\u0442 (USB)","Shipping Estimated Time":"\u041F\u0440\u0438\u043C\u0435\u0440\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438","The first time order,  the shipping cost will be free!":"\u041F\u0435\u0440\u0432\u044B\u0439 \u0437\u0430\u043A\u0430\u0437, \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0431\u0443\u0434\u0435\u0442 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E\u0439!","HASL(with lead)":"HASL(\u0441\u043E \u0441\u0432\u0438\u043D\u0446\u043E\u043C)","LeadFree HASL-RoHS":"HASL-RoHS(\u0431\u0435\u0441\u0441\u0432\u0438\u043D\u0435\u0446)","The PCB has {drcErrors} DRC errors.":"\u0423 \u043F\u043B\u0430\u0442\u044B \u0435\u0441\u0442\u044C {drcErrors} DRC \u043E\u0448\u0438\u0431\u043E\u043A.","Do you want to check the DRC errors?":"\u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043D\u0430 DRC \u043E\u0448\u0438\u0431\u043A\u0438\uFF1F","Check DRC Errors":"\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043D\u0430 DRC \u043E\u0448\u0438\u0431\u043A\u0438","Ignore and Continue":"\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C","It will then redirect to the web site of a thirdparty JLCPCB with which we cooperate.Are you ready?":"\u0412\u044B \u0431\u0443\u0434\u0435\u0442\u0435 \u043F\u0435\u0440\u0435\u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u0441\u0430\u0439\u0442 JLCPCB, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043C\u044B \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0435\u043C. \u0412\u044B \u0433\u043E\u0442\u043E\u0432\u044B?","Failed to submit your order,please contact us via support@easyeda.com for help.":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0430\u0448 \u0437\u0430\u043A\u0430\u0437, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u0432\u044F\u0436\u0438\u0442\u0435\u0441\u044C \u0441 \u043D\u0430\u043C\u0438 \u043F\u043E \u0430\u0434\u0440\u0435\u0441\u0443 support@easyeda.com.","@@generateGerber":{Layers:"\u0421\u043B\u043E\u0438"},"Create a new Project...":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442...","Create a new Schematic":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u0443\u044E \u0441\u0445\u0435\u043C\u0443","Create a new Schematic Lib":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u0443\u044E \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0443 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432","Create a new Spice Symbol":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442","Create a new Spice Subckt":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u0443\u044E \u0441\u0445\u0435\u043C\u0443","Create a new PCB":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u0443\u044E \u043F\u043B\u0430\u0442\u0443","Create a new PCB Lib":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439 \u043A\u043E\u0440\u043F\u0443\u0441","Create a new Schematic Module":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439 \u043C\u043E\u0434\u0443\u043B\u044C","Create a new PCB Module":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439 PCB \u043C\u043E\u0434\u0443\u043B\u044C","Export your file, then print it yourself.":"\u042D\u043A\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u0441\u0432\u043E\u0439 \u0444\u0430\u0439\u043B, \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u0439\u0442\u0435 \u0435\u0433\u043E \u0441\u0430\u043C\u0438.","Trace width is too small":"\u0428\u0438\u0440\u0438\u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F","Images Attribute":"\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0439","Connect Pad to Pad":"\u0421\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443 \u0441 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u043E\u0439","Copper Area":"\u041C\u0435\u0434\u043D\u044B\u0439 \u043F\u043E\u043B\u0438\u0433\u043E\u043D",Dimension:"\u0420\u0430\u0437\u043C\u0435\u0440\u044B","May be you should use wire but not polyline to connect electrical elements.":"\u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u0430, \u0430 \u043D\u0435 \u043F\u043E\u043B\u0438\u043B\u0438\u043D\u0438\u0438 \u0434\u043B\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432.","PCB Fabrication Prices & capabilities":"\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u043F\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0443 \u043F\u043B\u0430\u0442 \u0438 \u0446\u0435\u043D\u044B","Flip all texts on bottom layer":"\u0420\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u0432\u0435\u0441\u044C \u0442\u0435\u043A\u0441\u0442 \u043D\u0430 \u043D\u0438\u0436\u043D\u0435\u043C \u0441\u043B\u043E\u0435","EasyEDA Libs":"\u0411\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438 EasyEDA","Your parter's email":"\u042D\u043B. \u043F\u043E\u0447\u0442\u0430 \u0432\u0430\u0448\u0435\u0433\u043E \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0430","Create New Document":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442","Anonymous file":"\u0410\u043D\u043E\u043D\u0438\u043C\u043D\u044B\u0439 \u0444\u0430\u0439\u043B","User Package":"\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u043F\u0443\u0441","General Package":"\u0421\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0439 \u043A\u043E\u0440\u043F\u0443\u0441","General Packages":"\u0421\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0435 \u043A\u043E\u0440\u043F\u0443\u0441\u0430","favorite Package":"\u043B\u044E\u0431\u0438\u043C\u044B\u0435 \u043A\u043E\u0440\u043F\u0443\u0441\u0430","Through Hole":"\u041C\u043E\u043D\u0442\u0430\u0436 \u0432 \u043E\u0442\u0432\u0435\u0440\u0441\u0438\u044F","Surface Mount":"\u041F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u044B\u0439 \u043C\u043E\u043D\u0442\u0430\u0436","Markdown Syntax":"\u0421\u0438\u043D\u0442\u0430\u043A\u0441\u0438\u0441 \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u0438","Support markdown":"\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u0430","Read only":"\u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u0435\u043D\u0438\u0435","Read/Write":"\u0427\u0442\u0435\u043D\u0438\u0435/\u0437\u0430\u043F\u0438\u0441\u044C","More Libraries...":"\u0411\u043E\u043B\u044C\u0448\u0435 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A...","Decompress failed!":"\u0420\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u043A\u0430 \u043D\u0435 \u0443\u0434\u0430\u043B\u0430\u0441\u044C\uFF01","Load failed!":"\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u043D\u0435 \u0443\u0434\u0430\u043B\u0430\u0441\u044C!","Loading...":"\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430...","No Result":"\u041D\u0435\u0442 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432","I know. Do not show this again.":"\u042F \u0437\u043D\u0430\u044E, \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C.","Extensions Setting":"\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0439",Remove:"\u0423\u0434\u0430\u043B\u0438\u0442\u044C",Disable:"\u041E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C",Enable:"\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C","(Disabled)":"(\u041E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u043E)","(Enabled)":"(\u0412\u043A\u043B\u044E\u0447\u0435\u043D\u043E)","Load Extension":"\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435","Enable or disable will be applied after reload page":"\u0412\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u0438\u043B\u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u0432\u0441\u0442\u0443\u043F\u0438\u0442 \u0432 \u0441\u0438\u043B\u0443 \u043F\u043E\u0441\u043B\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B","Your browser cannot run this function.":"\u0412\u0430\u0448\u0435\u043C\u0443 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0443 \u043D\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u044D\u0442\u0430 \u0444\u0443\u043D\u043A\u0446\u0438\u044F.","Extension Files":"\u0424\u0430\u0439\u043B\u044B \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F","Extension ID":"ID \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F","Select Files":"\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u0430\u0439\u043B\u044B",Script:"\u0421\u043A\u0440\u0438\u043F\u0442",Scripts:"\u0421\u043A\u0440\u0438\u043F\u0442\u044B","Script Content":"\u0421\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u0441\u043A\u0440\u0438\u043F\u0442\u0430","Load from js file":"\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0438\u0437 js \u0444\u0430\u0439\u043B\u0430","UTF-8 encoded js file":"js \u0444\u0430\u0439\u043B \u0432 \u043A\u043E\u0434\u0438\u0440\u043E\u0432\u043A\u0435 UTF-8",Description:"\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435",description:"\u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435","Not a *.js file":"\u041D\u0435 *.js \u0444\u0430\u0439\u043B","Failed to read file":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0444\u0430\u0439\u043B","System scripts cannot be modified":"\u041D\u0435\u043B\u044C\u0437\u044F \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0435 \u0441\u043A\u0440\u0438\u043F\u0442\u044B","Create Subfolder":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043F\u043E\u0434\u043F\u0430\u043F\u043A\u0443","Create Script":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u0441\u043A\u0440\u0438\u043F\u0442","Install Script":"\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0441\u043A\u0440\u0438\u043F\u0442",Install:"\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C","Are you sure to remove this script?":"\u0412\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0445\u043E\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u044D\u0442\u043E\u0442 \u0441\u043A\u0440\u0438\u043F\u0442\uFF1F","Folder Name":"\u0418\u043C\u044F \u043F\u0430\u043F\u043A\u0438",Rename:"\u041F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u0442\u044C","Please select a script":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043A\u0440\u0438\u043F\u0442","Failed to load script":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0441\u043A\u0440\u0438\u043F\u0442","Run Script":"\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0441\u043A\u0440\u0438\u043F\u0442","Load Script":"\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0441\u043A\u0440\u0438\u043F\u0442","Title is required":"\u0423\u043A\u0430\u0436\u0438\u0442\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435","Script content is required":"\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u0441\u043A\u0440\u0438\u043F\u0442\u0430","System Scripts":"\u0421\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0435 \u0441\u043A\u0440\u0438\u043F\u0442\u044B","User Scripts":"\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435 \u0441\u043A\u0440\u0438\u043F\u0442\u044B","You can right click on the tree nodes.":"\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0449\u0451\u043B\u043A\u043D\u0443\u0442\u044C \u043F\u0440\u0430\u0432\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043C\u044B\u0448\u0438 \u043F\u043E tree nodes.","Top Side":"\u0412\u0435\u0440\u0445\u043D\u044F\u044F \u0441\u0442\u043E\u0440\u043E\u043D\u0430","Bottom Side":"\u041D\u0438\u0436\u043D\u044F\u044F \u0441\u0442\u043E\u0440\u043E\u043D\u0430","With Silk Layer":"\u0421 \u0448\u0435\u043B\u043A\u043E\u0433\u0440\u0430\u0444\u0438\u0435\u0439","No Silk Layer":"\u0411\u0435\u0437 \u0448\u0435\u043B\u043A\u043E\u0433\u0440\u0430\u0444\u0438\u0438","Photo View":"\u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 \u043F\u043B\u0430\u0442\u044B","Check Update":"\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F","EasyEDA Editor {ver} is released. Would you like to switch to the new version now?":"\u0412\u044B\u0448\u043B\u0430 {ver} \u0432\u0435\u0440\u0441\u0438\u044F \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0430 EasyEDA. \u0425\u043E\u0442\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u043D\u0430 \u043D\u043E\u0432\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E \u0441\u0435\u0439\u0447\u0430\u0441?","Switch to New Version":"\u041F\u0435\u0440\u0435\u0439\u0442\u0438 \u043D\u0430 \u043D\u043E\u0432\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E","Next Time":"\u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437","Generating download link...":"\u0413\u0435\u043D\u0435\u0440\u0438\u0440\u0443\u0435\u043C \u0441\u0441\u044B\u043B\u043A\u0443 \u0441\u043A\u0430\u0447\u0438\u0432\u0430\u043D\u0438\u044F...","Download project now":"\u0421\u043A\u0430\u0447\u0430\u0442\u044C \u043F\u0440\u043E\u0435\u043A\u0442 \u0441\u0435\u0439\u0447\u0430\u0441","Import DXF":"\u0418\u043C\u043F\u043E\u0440\u0442 dxf","DXF Unit":"\u0415\u0434\u0438\u043D\u0438\u0446\u044B DXF","No shapes found":"\u0424\u0438\u0433\u0443\u0440 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043E","Fail to load the file":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0444\u0430\u0439\u043B","Please select a DXF file.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 DXF \u0444\u0430\u0439\u043B.","This feature only works for PCB document.":"\u042D\u0442\u0430 \u0444\u0443\u043D\u043A\u0446\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u043F\u043B\u0430\u0442.","Select a dxf file":"\u0412\u044B\u0431\u0440\u0430\u0442\u044C dxf \u0444\u0430\u0439\u043B","Data Sync":"\u0421\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u0434\u0430\u043D\u043D\u044B\u0445","Data Conflicts":"\u041A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u044B \u0434\u0430\u043D\u043D\u044B\u0445","Project or Document":"\u041F\u0440\u043E\u0435\u043A\u0442 \u0438\u043B\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442","Cloud-Side":"\u041D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435","Local-Side":"\u0412 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435",Decision:"\u0420\u0435\u0448\u0435\u043D\u0438\u0435",Modified:"\u0418\u0437\u043C\u0435\u043D\u0435\u043D\u043E",Deleted:"\u0423\u0434\u0430\u043B\u0435\u043D\u043E","As Cloud":"\u0412 \u043E\u0431\u043B\u0430\u043A\u0435","As Local":"\u0412 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435","Data sync completed":"\u0421\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u0434\u0430\u043D\u043D\u044B\u0445 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430",Team:"\u041A\u043E\u043C\u0430\u043D\u0434\u0430",Teams:"\u041A\u043E\u043C\u0430\u043D\u0434\u044B","Switching team":"\u041C\u0435\u043D\u044F\u0435\u043C \u043A\u043E\u043C\u0430\u043D\u0434\u0443","Switch team failed":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043C\u0435\u043D\u0438\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u0443","Load team info fail!":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0435!","Load team info fail! Please reload again.":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0435! \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437.","My Teams":"\u041C\u043E\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u044B","Create Team":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u0443","Footprint Manager":"\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440 \u0448\u0435\u043B\u043A\u043E\u0433\u0440\u0430\u0444\u0438\u0438","Schematic Components":"\u041A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B \u0441\u0445\u0435\u043C\u044B","Package Categories":"\u0412\u0438\u0434\u044B \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u0432","Components List":"\u0421\u043F\u0438\u0441\u043E\u043A \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432",Personal:"\u041B\u0438\u0447\u043D\u044B\u0439","Component PIN information":"\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0430\u0445 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430","Footprint Categories":"\u0412\u0438\u0434\u044B \u0448\u0435\u043B\u043A\u043E\u0433\u0440\u0430\u0444\u0438\u0438","Pad Number":"\u041D\u043E\u043C\u0435\u0440 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438","Search PCB Libs":"\u041F\u043E\u0438\u0441\u043A \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u0432","Filter by keyword":"\u041F\u043E\u0438\u0441\u043A \u043F\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u043C \u0441\u043B\u043E\u0432\u0430\u043C","System Libs":"\u0421\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0435 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438",Drawings:"\u0413\u0440\u0430\u0444\u0438\u043A\u0443","Netlabel and netFlag":"Netlabel \u0438 netFlag",Texts:"\u0422\u0435\u043A\u0441\u0442",Wires:"\u041F\u0440\u043E\u0432\u043E\u0434\u0430","Board outlines":"\u0413\u0440\u0430\u043D\u0438\u0446\u044B \u043F\u043B\u0430\u0442\u044B",Footprints:"\u0428\u0435\u043B\u043A\u043E\u0433\u0440\u0430\u0444\u0438\u044E",Tracks:"\u0414\u043E\u0440\u043E\u0436\u043A\u0438","width and height":"\u0448\u0438\u0440\u0438\u043D\u0430 \u0438 \u0432\u044B\u0441\u043E\u0442\u0430","Create rectangular board":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u0443\u044E \u043F\u043B\u0430\u0442\u0443","Create circular board":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043A\u0440\u0443\u0433\u043B\u0443\u044E \u043F\u043B\u0430\u0442\u0443",radius:"\u0440\u0430\u0434\u0438\u0443\u0441","Create round rectangular board":"\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u0441\u043E \u0441\u043A\u0440\u0443\u0433\u043B\u0451\u043D\u043D\u044B\u043C\u0438 \u0443\u0433\u043B\u0430\u043C\u0438","The object you select was not found in other documents.":"\u041E\u0431\u044A\u0435\u043A\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0438 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0445.","No valid object for cross probe selected.":"\u041D\u0435 \u0432\u044B\u0431\u0440\u0430\u043D \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u044B\u0439 \u043E\u0431\u044A\u0435\u043A\u0442 \u0434\u043B\u044F cross probe.","Can not probe.Refreshing the window may get it to work.":"Can not probe. \u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u043E\u043A\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043C\u043E\u0447\u044C.","You need to login to get the function to work.":"\u0427\u0442\u043E\u0431\u044B \u044D\u0442\u0430 \u0444\u0443\u043D\u043A\u0446\u0438\u044F \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u0432\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0432\u043E\u0439\u0442\u0438.","An Easier EDA Experience":"\u0415\u0449\u0451 \u0431\u043E\u043B\u0435\u0435 \u043F\u0440\u043E\u0441\u0442\u0430\u044F EasyEDA",Version:"\u0412\u0435\u0440\u0441\u0438\u044F",BuiltDate:"\u0414\u0430\u0442\u0430 \u0441\u0431\u043E\u0440\u043A\u0438","Auto Router Config":"\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0430\u0432\u0442\u043E\u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0430","Sorry, your web browser does not support this feature. Please run a modern browser.":"\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u0432\u0430\u0448 \u0431\u0440\u0430\u0443\u0437\u0435\u0440 \u043D\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u044D\u0442\u0443 \u0444\u0443\u043D\u043A\u0446\u0438\u044E. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0431\u0440\u0430\u0443\u0437\u0435\u0440.","Please make sure all components inside the board outline!":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u0432\u0441\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432 \u0433\u0440\u0430\u043D\u0438\u0446\u0430\u0445 \u043F\u043B\u0430\u0442\u044B!","Cannot start again before previous is not stopped":"\u041D\u0435\u043B\u044C\u0437\u044F \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0437\u0430\u043D\u043E\u0432\u043E, \u043F\u043E\u043A\u0430 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0430\u044F \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u043A\u0430","Please select a net":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0448\u0438\u043D\u0443","Router completed successfully.":"\u0422\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u043A\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430.","Router is time out.":"\u0412\u0440\u0435\u043C\u044F \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u043A\u0438 \u0432\u044B\u0448\u043B\u043E.","Server is busy, please try again later.":"\u0421\u0435\u0440\u0432\u0435\u0440 \u0437\u0430\u043D\u044F\u0442, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u043E\u0437\u0436\u0435.","Due to the limitation of {0}router server{1} resources, multiple routers execute concurrently are not supported, please try again later or do it manually :-)":"\u0418\u0437-\u0437\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 {0}\u0441\u0435\u0440\u0432\u0435\u0440\u0430 \u0430\u0432\u0442\u043E\u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0430{1} \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0437\u0430\u043F\u0443\u0441\u043A \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u0449\u0438\u043A \u043D\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u043E\u0437\u0436\u0435 \u0438\u043B\u0438 \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u0432\u043E\u0434\u043A\u0443 \u0432\u0440\u0443\u0447\u043D\u0443\u044E :-)","Track Width is invalid":"\u0428\u0438\u0440\u0438\u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0438 \u043D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u0430","General Clearance is invalid":"\u041E\u0442\u0441\u0442\u0443\u043F \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E \u043D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0435\u043D","SMD Clearance is invalid":"\u041D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u044B\u0439 \u043E\u0442\u0441\u0442\u0443\u043F \u043C\u0435\u0436\u0434\u0443 SMD","Diameter is invalid":"\u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u043D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0435\u043D","Hole(D) is invalid":"\u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F \u043D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0435\u043D","Track width cannot be less than DRC setting value.":"\u0428\u0438\u0440\u0438\u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F DRC.","General Clearance cannot be less than DRC setting value.":"\u041E\u0442\u0441\u0442\u0443\u043F\u044B \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F DRC.","SMD Clearance cannot be less than DRC setting value.":"\u041E\u0442\u0441\u0442\u0443\u043F \u043C\u0435\u0436\u0434\u0443 SMD \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F DRC.","Hole size cannot be less than DRC setting value.":"\u0420\u0430\u0437\u043C\u0435\u0440 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F DRC.","Diameter must be greater than hole size.":"\u0414\u0438\u0430\u043C\u0435\u0442\u0440 \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u0430\u0437\u043C\u0435\u0440\u0430 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F.","Clearance cannot be less than DRC setting value.":"\u041E\u0442\u0441\u0442\u0443\u043F \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F DRC.","Not a valid PCB, please check it again":"\u041D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u0430\u044F \u043F\u043B\u0430\u0442\u0430, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437","Previous connection must be closed":"\u041F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u043E","Network error. Please try again.":"\u041E\u0448\u0438\u0431\u043A\u0430 \u0441\u0435\u0442\u0438. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437 \u043F\u043E\u0437\u0436\u0435.","Router error.":"\u041E\u0448\u0438\u0431\u043A\u0430 \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0430.","Invalid PCB.":"\u041D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u0430\u044F \u043F\u043B\u0430\u0442\u0430.","General Clearance":"\u041E\u0442\u0441\u0442\u0443\u043F\u044B \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E","SMD Clearance":"\u041E\u0442\u0441\u0442\u0443\u043F \u043C\u0435\u0436\u0434\u0443 SMD","Skip Routed Nets":"\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0435 \u0448\u0438\u043D\u044B","Remove Existing Tracks":"\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435 \u0434\u043E\u0440\u043E\u0436\u043A\u0438","Real-time Display":"\u041E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438","Router Layers":"\u0421\u043B\u043E\u0438 \u0442\u0440\u0430\u043D\u0441\u0441\u0438\u0440\u043E\u0432\u043A\u0438",Via:"\u041F\u0435\u0440\u0435\u0445\u043E\u0434\u043D\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435",Special:"\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435","Special Nets":"\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0448\u0438\u043D\u044B","Skip Nets":"\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0448\u0438\u043D\u0443","Router Server":"\u0421\u0435\u0440\u0432\u0435\u0440 \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u043A\u0438",Local:"\u041B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0439",Cloud:"\u041E\u0431\u043B\u0430\u0447\u043D\u044B\u0439",Available:"\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u043E",Unavailable:"\u041D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E",Checking:"\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430","How to use?":"\u041A\u0430\u043A \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C?","How to available?":"\u041A\u0430\u043A \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u043C?","Checking local auto router server...":"\u041F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u043C \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0435\u0440\u0432\u0435\u0440 \u0430\u0432\u0442\u043E\u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0430...","Stop Router":"\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u0449\u0438\u043A","Auto Router is running...":"\u0410\u0432\u0442\u043E\u0442\u0440\u0430\u0441\u0441\u0438\u0440\u043E\u0432\u0449\u0438\u043A \u0432 \u0440\u0430\u0431\u043E\u0442\u0435...","@@left_bar":{"Design{0}Manager":"\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440{0}\u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F"},Libraries:"\u0411\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438","US Style":"\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0441\u043A\u0438\u0439 \u0441\u0442\u0438\u043B\u044C","EU/IEC Style":"\u0415\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0439 \u0441\u0442\u0438\u043B\u044C",Connector:"\u041A\u043E\u043D\u043D\u0435\u043A\u0442\u043E\u0440","Switch/Relay":"\u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C/\u0420\u0435\u043B\u0435","Font Height":"\u0412\u044B\u0441\u043E\u0442\u0430 \u0448\u0440\u0438\u0444\u0442\u0430",Precision:"\u0422\u043E\u0447\u043D\u043E\u0441\u0442\u044C",Protractor:"\u041F\u0440\u043E\u0442\u0440\u0430\u043A\u0442\u043E\u0440","Changing line width won't work for silhouette fonts.":"\u0428\u0438\u0440\u0438\u043D\u0430 \u0448\u0440\u0438\u0444\u0442\u0430 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E.","Font is missing! You can confirm the dialog and use default font instead or cancel the dialog then upload your font and do it again.":"\u0428\u0440\u0438\u0444\u0442 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442! \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0448\u0440\u0438\u0444\u0442 \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E \u0438\u043B\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0441\u0432\u043E\u0439 \u0448\u0440\u0438\u0444\u0442 \u0441\u043D\u043E\u0432\u0430.",Owner:"\u0412\u043B\u0430\u0434\u0435\u043B\u0435\u0446",License:"\u041B\u0438\u0446\u0435\u043D\u0437\u0438\u044F","Part Pins":"\u041A\u043E\u043D\u0442\u0430\u043A\u0442\u044B \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432","Net Pins":"\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043A \u0448\u0438\u043D\u0435","Histories record":"\u0418\u0441\u0442\u043E\u0440\u0438\u044F","The assigned package has been modified, please re-assign.":"\u0412\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u0440\u043F\u0443\u0441 \u0431\u044B\u043B \u0438\u0437\u043C\u0435\u043D\u0451\u043D, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0435 \u043A\u043E\u0440\u043F\u0443\u0441.","Package is not assigned. Please assign a package.":"\u041A\u043E\u0440\u043F\u0443\u0441 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u043D. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u043E\u0440\u043F\u0443\u0441.","The path is for the project URL identify, it is unique (the identity of the project owned by the user cannot be the same)":"ID \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043A\u0430\u043A \u0447\u0430\u0441\u0442\u044C URL \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0438 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C","It's with a letter or a number and can contain only numbers, letters, line-through, underscores, and points, and it cannot be modified after saving.":"\u041C\u043E\u0436\u0435\u0442 \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C\u0441\u044F \u0441 \u0446\u0438\u0444\u0440 \u0438 \u0431\u0443\u043A\u0432, \u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0446\u0438\u0444\u0440\u044B, \u0431\u0443\u043A\u0432\u044B, \u0442\u0438\u0440\u0435, \u043D\u0438\u0436\u043D\u0435\u0435 \u043F\u043E\u0434\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u043D\u0438\u0435 \u0438 \u0442\u043E\u0447\u043A\u0438, \u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u043E \u043F\u043E\u0441\u043B\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F.","Updating document to new format, please wait......After finish please save your document with Ctrl + S.":"\u041E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0434\u043E \u043D\u043E\u0432\u043E\u0433\u043E \u0444\u043E\u0440\u043C\u0430\u0442\u0430, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435... \u041F\u043E\u0441\u043B\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435 \u0432\u0430\u0448 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043D\u0430\u0436\u0430\u0432 Ctrl + S).","Open at current project?":"\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0432 \u0442\u0435\u043A\u0443\u0449\u0435\u043C \u043F\u0440\u043E\u0435\u043A\u0442\u0435\uFF1F","Please select a history to recover.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0437\u0430\u043F\u0438\u0441\u044C \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0434\u043B\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F.",'Becareful! When you click the "Recover" button, this sheet will be overwritten!':'\u0411\u0443\u0434\u044C\u0442\u0435 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B! \u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u043D\u0430\u0436\u043C\u0451\u0442\u0435 "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C", \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0431\u0443\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u0430\u043D!',Recover:"\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C","Save As a New Project":"\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043A\u0430\u043A \u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442","There is no PCB under this project, do you like to create one?":"\u041D\u0435\u0442 \u043F\u043B\u0430\u0442 \u0432 \u044D\u0442\u043E\u043C \u043F\u0440\u043E\u0435\u043A\u0442\u0435, \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043F\u043B\u0430\u0442\u0443?","Please make sure that the chose Altium Designer files are saved as ASCII files.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u0444\u0430\u0439\u043B\u044B Altium Designer \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B \u0432 \u043A\u043E\u0434\u0438\u0440\u043E\u0432\u043A\u0435 ASCII.","Please make sure that the chose Eagle files are saved in Eagle v6.0 and above.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u0444\u0430\u0439\u043B\u044B Eagle \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u044B \u0432 Eagle v6.0 \u0438\u043B\u0438 \u0432\u044B\u0448\u0435.","Please make sure that the Kicad files were compressed as the .zip file.":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E Kicad \u0444\u0430\u0439\u043B\u044B \u0431\u044B\u043B\u0438 \u0443\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u044B \u0432 .zip \u0430\u0440\u0445\u0438\u0432.","Open Altium Designer file":"\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0444\u0430\u0439\u043B Altium Designer","Open Eagle file":"\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0444\u0430\u0439\u043B Eagle","Open Kicad file":"\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0444\u0430\u0439\u043B Kicad","Select file(s)":"\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u0430\u0439\u043B(\u044B)","Append to current project?":"\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432 \u0442\u0435\u043A\u0443\u0449\u0438\u0439 \u043F\u0440\u043E\u0435\u043A\u0442\uFF1F",Append:"\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044C","Open as new project":"\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043A\u0430\u043A \u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442","Tip: Press {0}SPACE{1} or {2}R{3} to rotate the placing object or selected object.":"\u0421\u043E\u0432\u0435\u0442: \u041D\u0430\u0436\u043C\u0438\u0442\u0435 {0}\u043F\u0440\u043E\u0431\u0435\u043B{1} \u0438\u043B\u0438 {2}R{3}, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u043C\u044B\u0439 \u0438\u043B\u0438 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439 \u043E\u0431\u044A\u0435\u043A\u0442.","Hotkeys Setting":"\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0433\u043E\u0440\u044F\u0447\u0438\u0445 \u043A\u043B\u0430\u0432\u0438\u0448","I know. Don't show this again.":"\u0417\u043D\u0430\u044E, \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C","Manfactuer Part Number can not be empty, if you don't konw, just type  any words":"\u041D\u043E\u043C\u0435\u0440 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430 \u0443 \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u0430 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043F\u0443\u0441\u0442\u044B\u043C, \u0435\u0441\u043B\u0438 \u0432\u044B \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\u0435, \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u043B\u044E\u0431\u044B\u0435 \u0431\u0443\u043A\u0432\u044B \u0438 \u0446\u0438\u0444\u0440\u044B","This prefix was changed to non-subpart format.":"\u042D\u0442\u043E\u0442 \u043F\u0440\u0435\u0444\u0438\u043A\u0441 \u0431\u044B\u043B \u0438\u0437\u043C\u0435\u043D\u0451\u043D \u043D\u0430 \u043D\u0435\u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0439 \u0441 \u043F\u043E\u0434\u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430\u043C\u0438 \u0444\u043E\u0440\u043C\u0430\u0442.","Save as New Project":"\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0432 \u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442","Save to Existing Project":"\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0432 \u0442\u0435\u043A\u0443\u0449\u0435\u043C \u043F\u0440\u043E\u0435\u043A\u0442\u0435","Sheet Setting":"\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043B\u0438\u0441\u0442\u0430","Sheet Size":"\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u043B\u0438\u0441\u0442\u0430",Pre:"\u041D\u043E\u043C\u0435\u0440",pre:"\u043D\u043E\u043C\u0435\u0440","Invalid Data":"\u041D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435",Others:"\u0414\u0440\u0443\u0433\u0438\u0435","You are not authorized to share this project.":"\u0412\u0430\u043C \u043D\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u043E \u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u044D\u0442\u0438\u043C \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u043C.","This project is private, it will be public if you continue sharing.":"\u042D\u0442\u043E\u0442 \u043F\u0440\u043E\u0435\u043A\u0442 \u043F\u0440\u0438\u0432\u0430\u0442\u043D\u044B\u0439, \u043E\u043D \u0441\u0442\u0430\u043D\u0435\u0442 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u044B\u043C, \u0435\u0441\u043B\u0438 \u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435 \u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F.","Modify file info":"\u0418\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u043E \u0444\u0430\u0439\u043B\u0435","Please input search keyword":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u0441\u043B\u043E\u0432\u0430 \u0434\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430","Sort By":"\u0421\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043F\u043E","Date Created":"\u0414\u0430\u0442\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F","Date Modified":"\u0414\u0430\u0442\u0430 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F",Ascending:"\u041F\u043E \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0430\u043D\u0438\u044E",Descending:"\u041F\u043E \u0443\u0431\u044B\u0432\u0430\u043D\u0438\u044E","Expand All":"\u0420\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0432\u0441\u0435","Collapse All":"\u0421\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0432\u0441\u0435","Your file hasn't been saved. Would you like to save it now?":"\u0412\u0430\u0448 \u0444\u0430\u0439\u043B \u043D\u0435 \u0431\u044B\u043B \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D, \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0435\u0433\u043E?","Don't Save":"\u041D\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C","Library Owner:":"\u0412\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438:","verifyPkg.Value":"\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435",State:"\u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435","Please select!":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435\uFF01",Route:"\u0420\u0430\u0437\u0432\u043E\u0434\u043A\u0430","Import successfully:":"\u0423\u0441\u043F\u0435\u0448\u043D\u043E \u0438\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043E:","Import failed:":"\u0418\u043C\u043F\u043E\u0440\u0442 \u043D\u0435 \u0443\u0434\u0430\u043B\u0441\u044F:","The title must be between 4 and 128 charaters.":"\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u043E\u0442 4 \u0434\u043E 128 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432.","your title is too short":"\u0432\u0430\u0448\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435","Path only contain 'a-z\u3001A-Z\u3001- \u3001 _ \u30010-9'!":"\u041F\u0443\u0442\u044C \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0446\u0438\u0444\u0440\u044B, \u043B\u0430\u0442\u0438\u043D\u0441\u043A\u0438\u0435 \u0431\u0443\u043A\u0432\u044B, \u0442\u0438\u0440\u0435 \u0438 \u043D\u0438\u0436\u043D\u0435\u0435 \u043F\u043E\u0434\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u043D\u0438\u0435!","Path must begin as 'a-z\u3001A-Z\u30010-9'!":"\u041F\u0443\u0442\u044C \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u043B\u0430\u0442\u0438\u043D\u0441\u043A\u0438\u0445 \u0431\u0443\u043A\u0432 \u0438 \u0446\u0438\u0444\u0440!","The path length is in 4~128 charaters!":"\u0414\u043B\u0438\u043D\u0430 \u043F\u0443\u0442\u0438 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043E\u0442 4 \u0434\u043E 128 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432!","Do you want to delete the file":"\u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u0444\u0430\u0439\u043B","Add sub part success":"\u041F\u043E\u0434\u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D","Please input name and pre!":"\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043C\u044F \u0438 \u043D\u043E\u043C\u0435\u0440!","Board outlines are not closed":"\u0413\u0440\u0430\u043D\u0438\u0446\u044B \u043F\u043B\u0430\u0442\u044B \u043D\u0435 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044B","failed to read {0}":"\u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C {0}","{0} is invalid":"{0} \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043D\u0435\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u043D\u044B\u043C","{0} not found":"{0} \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D","failed to execute script:":"\u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0441\u043A\u0440\u0438\u043F\u0442:","one or more js files not found":"\u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043E \u043E\u0434\u0438\u043D \u0438\u043B\u0438 \u0431\u043E\u043B\u0435\u0435 js \u0444\u0430\u0439\u043B\u043E\u0432","Only ONE {0} file i