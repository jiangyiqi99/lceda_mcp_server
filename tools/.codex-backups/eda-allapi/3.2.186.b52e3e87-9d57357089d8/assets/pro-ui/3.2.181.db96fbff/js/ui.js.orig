5C06\u9501\u5B9A\u7684\u5143\u4EF6\u4E00\u8D77\u590D\u7528\uFF1F","The selected object {objectID} already exists in group {groupName}, cannot be reused":"\u9009\u62E9\u7684\u5BF9\u8C61 {objectID} \u5DF2\u5B58\u5728\u7EC4\u5408 {groupName} \u4E2D\uFF0C\u65E0\u6CD5\u88AB\u590D\u7528\u3002","Constraint associated object {0} is currently locked, please unlock first.":"\u7EA6\u675F\u5173\u8054\u5BF9\u8C61 {0} \u5F53\u524D\u4E3A\u9501\u5B9A\u72B6\u6001\uFF0C\u8BF7\u5148\u89E3\u9501\u3002","Constraint associated object {0} are currently locked, please unlock them first.":"\u7EA6\u675F\u5173\u8054\u5BF9\u8C61 {0} \u5F53\u524D\u5747\u4E3A\u9501\u5B9A\u72B6\u6001\uFF0C\u8BF7\u5148\u89E3\u9501\u3002","This change will lead to over definition or no solution, modification failed.":"\u6B64\u53D8\u66F4\u5C06\u5BFC\u81F4\u8FC7\u5B9A\u4E49\u6216\u65E0\u89E3\uFF0C\u4FEE\u6539\u5931\u8D25\u3002",RECTANGLE:"\u77E9\u5F62",OCTAGONAL:"\u957F\u5706\u5F62","Upper left":"\u5DE6\u4E0A","Lower left":"\u5DE6\u4E0B","Center of Pads":"\u710A\u76D8\u4E2D\u592E","First Pin":"\u7B2C\u4E00\u5F15\u811A","Package Name":"\u5C01\u88C5\u540D","Pins Number":"\u5F15\u811A\u6570\u91CF","Rows Of Pin":"\u5F15\u811A\u884C\u6570","Columns Of Pin":"\u5F15\u811A\u5217\u6570",Polarity:"\u6781\u6027","Pad Shape":"\u710A\u76D8\u5F62\u72B6","Body Diameter":"\u672C\u4F53\u76F4\u5F84","Lead Span":"\u5F15\u811A\u8DE8\u8DDD","Lead Height":"\u5F15\u811A\u9AD8\u5EA6","Lead Vertical Span":"\u5F15\u811A\u7EB5\u5411\u8DE8\u8DDD","Body Length":"\u672C\u4F53\u957F\u5EA6","Body Width":"\u672C\u4F53\u5BBD\u5EA6","Pin Diameter":"\u5F15\u811A\u76F4\u5F84","Pin Height":"\u5F15\u811A\u5BBD\u5EA6","Pin Real Length":"\u5F15\u811A\u5B9E\u9645\u957F\u5EA6","Bending Spacing":"\u5F15\u811A\u5F2F\u6298\u95F4\u8DDD","Pin Solid Width":"\u5F15\u811A\u710A\u63A5\u957F\u5EA6","Pin Solid Height":"\u5F15\u811A\u710A\u63A5\u5BBD\u5EA6","Pin Spacing":"\u5F15\u811A\u95F4\u8DDD","Pin Horizontal Spacing":"\u5F15\u811A\u6A2A\u5411\u95F4\u8DDD","Pin Vertical Spacing":"\u5F15\u811A\u7EB5\u5411\u95F4\u8DDD",ThermalPad:"\u70ED\u710A\u76D8","Pad Expansion":"\u710A\u76D8\u6269\u5C55","Custom PasteMask":"\u81EA\u5B9A\u4E49\u9521\u818F\u5C42","Fabrication Tolerance":"\u5236\u9020\u5BB9\u5DEE","Placement Tolerance":"\u653E\u7F6E\u5BB9\u5DEE","FirstPin Position":"\u7B2C\u4E00\u5F15\u811A\u4F4D\u7F6E","Package Origin":"\u5C01\u88C5\u539F\u70B9","Expansion Size":"\u6269\u5C55\u5C3A\u5BF8","Right Angle":"\u76F4\u89D2",Fillet:"\u5706\u89D2",Chamfer:"\u659C\u89D2","Generate 3D Model":"\u751F\u62103D\u6A21\u578B","Apply IPC-7351B Footprint Name":"\u5E94\u7528IPC-7351B\u5C01\u88C5\u540D","Number of pins (left and right)":"\u5F15\u811A\u6570(\u5DE6\u53F3)","Number of pins (up and down)":"\u5F15\u811A\u6570(\u4E0A\u4E0B)","Reference Use Cases":"\u53C2\u8003\u7528\u4F8B","Package Type":"\u5C01\u88C5\u7C7B\u578B","Bidirectional Diode":"\u53CC\u5411\u4E8C\u6781\u7BA1","Crystal Oscillator":"\u6676\u632F","Entity Height":"\u5B9E\u4F53\u9AD8\u5EA6","Solder balls characteristic":"\u710A\u6599\u7403\u7279\u6027","Can collapse":"\u53EF\u584C\u843D","Non collapsible":"\u975E\u584C\u843D","Lead Overhang":"\u672C\u4F53\u60AC\u7A7A\u9AD8\u5EA6","Top Height":"\u5F15\u811A\u4E0A\u7AEF\u9AD8\u5EA6","Bottom Height":"\u5F15\u811A\u4E0B\u7AEF\u9AD8\u5EA6","Lead Thickness":"\u5F15\u811A\u539A\u5EA6","Unknown mistake":"\u672A\u77E5\u9519\u8BEF","Has ThermalVias":"\u6563\u70ED\u8FC7\u5B54","Polar Capacitance":"\u6781\u6027\u7535\u5BB9","Generate Footprint":"\u751F\u6210\u5C01\u88C5","Device Manager":"\u5668\u4EF6\u7BA1\u7406\u5668","Component Manager":"\u5143\u4EF6\u7BA1\u7406\u5668","Via Solder Mask Expansion":"\u8FC7\u5B54\u963B\u710A\u6269\u5C55","All Cover Oil":"\u5168\u90E8\u9ED8\u8BA4\u76D6\u6CB9","Follow Original Setting":"\u8DDF\u968F\u539F\u8BBE\u7F6E","The selection area must contain the same network copper filled before adding suture holes":"\u6846\u9009\u533A\u57DF\u5185\u5FC5\u987B\u5305\u542B\u540C\u7F51\u7EDC\u94FA\u94DC\u586B\u5145\u624D\u53EF\u6DFB\u52A0\u7F1D\u5408\u5B54","The selection area must contain the same network copper filled before removing suture holes":"\u6846\u9009\u533A\u57DF\u5185\u5FC5\u987B\u5305\u542B\u7F51\u7EDC\u94FA\u94DC\u586B\u5145\u624D\u53EF\u79FB\u9664\u7F1D\u5408\u5B54",Comment:"\u5907\u6CE8","The parameter does not conform to the rules: The pin span is at least 0.1 mm more than the body length!":"\u53C2\u6570\u4E0D\u7B26\u5408\u89C4\u5219\uFF1A\u5F15\u811A\u8DE8\u8DDD\u81F3\u5C11\u8D85\u51FA\u672C\u4F53\u957F\u5EA60.1\u6BEB\u7C73\uFF01","The parameter does not conform to the rules: The pin length is not less than 0.2 mm and not less than 0.05 of the body length!":"\u53C2\u6570\u4E0D\u7B26\u5408\u89C4\u5219\uFF1A\u5F15\u811A\u957F\u5EA6\u4E0D\u5C0F\u4E8E0.2\u6BEB\u7C73\u4E14\u4E0D\u5C0F\u4E8E\u672C\u4F53\u957F\u5EA6\u76840.05\uFF01","The parameter does not conform to the rules: The sum of the pin spacing and pin diameter cannot exceed the body length!":"\u53C2\u6570\u4E0D\u7B26\u5408\u89C4\u5219\uFF1A\u5F15\u811A\u95F4\u8DDD\u548C\u5F15\u811A\u76F4\u5F84\u4E4B\u548C\u4E0D\u80FD\u8D85\u8FC7\u672C\u4F53\u957F\u5EA6\uFF01","The parameter does not conform to the rules: The length of the dangling pin cannot exceed 2 times the length of the pin, and the pin length cannot be less than 0.5 mm!":"\u53C2\u6570\u4E0D\u7B26\u5408\u89C4\u5219\uFF1A\u60AC\u7A7A\u5F15\u811A\u957F\u5EA6\u4E0D\u80FD\u8D85\u8FC7\u5F15\u811A\u957F\u5EA6\u76842\u500D\uFF0C\u4E14\u5F15\u811A\u957F\u5EA6\u4E0D\u80FD\u5C0F\u4E8E0.5\u6BEB\u7C73\uFF01","The parameter does not conform to the rules: The length of the dangling pin cannot exceed 2 times the length of the pin!":"\u53C2\u6570\u4E0D\u7B26\u5408\u89C4\u5219\uFF1A\u60AC\u7A7A\u5F15\u811A\u957F\u5EA6\u4E0D\u80FD\u8D85\u8FC7\u5F15\u811A\u957F\u5EA6\u76842\u500D\uFF01","The parameter does not conform to the rules: The number of pins can only be 3, 5 or 6!":"\u53C2\u6570\u4E0D\u7B26\u5408\u89C4\u5219\uFF1A\u5F15\u811A\u6570\u91CF\u53EA\u80FD\u4E3A3,5\u62166!","You are trying to open a later version document, it may fail to open or an exception may be displayed. It is recommended to use the latest editor version to open it.":"\u4F60\u6B63\u5728\u5C1D\u8BD5\u6253\u5F00\u66F4\u9AD8\u7248\u672C\u7684\u6587\u6863\uFF0C\u53EF\u80FD\u4F1A\u51FA\u73B0\u65E0\u6CD5\u6253\u5F00\u6216\u663E\u793A\u5F02\u5E38\u73B0\u8C61\u3002\u5EFA\u8BAE\u4F7F\u7528\u6700\u65B0\u7248\u7F16\u8F91\u5668\u6253\u5F00\u3002","Default Netname":"\u9ED8\u8BA4\u7F51\u7EDC\u540D","Wire ID":"\u5BFC\u7EBFID","Designator + Pin Number":"\u4F4D\u53F7 + \u5F15\u811A\u7F16\u53F7","This computer":"\u672C\u673A","Menu Hotkey":"\u83DC\u5355\u5FEB\u6377\u952E","Shortcut keys used":"\u5DF2\u4F7F\u7528\u8BE5\u5FEB\u6377\u952E","Command used":"\u5DF2\u4F7F\u7528\u8BE5\u547D\u4EE4","Global Shortcut key":"\u5168\u5C40\u5FEB\u6377\u952E","Shortcut keys for menu display":"\u83DC\u5355\u663E\u793A\u65F6\u4F7F\u7528\u7684\u5FEB\u6377\u952E","Find by the hotkey":"\u6839\u636E\u5FEB\u6377\u952E\u67E5\u627E","Design Rule(Schematic)":"\u539F\u7406\u56FE\u8BBE\u8BA1\u89C4\u5219","Design Rule(PCB)":"PCB\u8BBE\u8BA1\u89C4\u5219","One-Click Order PCB":"PCB\u4E00\u952E\u4E0B\u5355","Expand and Modify Properties":"\u5C55\u5F00\u5E76\u4FEE\u6539\u5C5E\u6027","Symbol library management":"\u7B26\u53F7\u5E93\u7BA1\u7406","Easy Mode":"\u7B80\u6613\u6A21\u5F0F","Easy Mode(Std Edition library creation behavior, easy to use)":"\u7B80\u6613\u6A21\u5F0F(\u6807\u51C6\u7248\u5EFA\u5E93\u4EA4\u4E92\uFF0C\u7B80\u5355\u6613\u4E0A\u624B)","Professional Mode(Support the symbol reuse)":"\u4E13\u4E1A\u6A21\u5F0F(\u652F\u6301\u7B26\u53F7\u590D\u7528)","Professional Mode":"\u4E13\u4E1A\u6A21\u5F0F","Entry: Settings - System - General":"\u5165\u53E3\uFF1A\u8BBE\u7F6E - \u7CFB\u7EDF - \u5E38\u7528","(Std Edition library creation behavior, easy to use)":"(\u6807\u51C6\u7248\u5EFA\u5E93\u4EA4\u4E92\uFF0C\u7B80\u5355\u6613\u4E0A\u624B)","Will create the schematic symbol automatically when create component library, don't need to think about the symbol reuse concept":"\u521B\u5EFA\u5143\u4EF6\u81EA\u52A8\u521B\u5EFA\u539F\u7406\u56FE\u5E93\uFF0C\u4E0D\u9700\u8981\u8003\u8651\u7B26\u53F7\u590D\u7528\u7684\u6982\u5FF5","(Support the symbol reuse)":"\u652F\u6301\u7B26\u53F7\u590D\u7528","Support to bind with existed symbol when create component library, and independent symbol library management entry":"\u521B\u5EFA\u5143\u4EF6\u652F\u6301\u7ED1\u5B9A\u5DF2\u6709\u7B26\u53F7\uFF0C\u72EC\u7ACB\u7684\u7B26\u53F7\u5E93\u7BA1\u7406\u5165\u53E3","@@symbolType":{"Non-Electronic":"\u65E0\u7535\u6C14\u6807\u8BC6","Non-Electronic Symbol":"\u65E0\u7535\u6C14\u7B26\u53F7",Drawing:"\u56FE\u7EB8","Drawing Symbol":"\u56FE\u7EB8\u7B26\u53F7"},":":"\uFF1A","The component unique ID will be reset according to the component designator, this operation will clear Undo histories. Please notice:":"\u5C06\u6839\u636E\u5143\u4EF6\u4F4D\u53F7\u91CD\u7F6E\u5143\u4EF6\u552F\u4E00ID\uFF0C\u8BE5\u64CD\u4F5C\u5C06\u6E05\u7A7A\u56DE\u9000\u8BB0\u5F55\u3002\u91CD\u7F6E\u524D\u8BF7\u6CE8\u610F\uFF1A","1. Please make sure the component designators\xA0of the schematic and PCB are corresponding":"1. \u8BF7\u786E\u4FDD\u539F\u7406\u56FE\u548C PCB \u7684\u5143\u4EF6\u4F4D\u53F7\u76F8\u5BF9\u5E94","2.\xA0Please reset the\xA0corresponding schematic or PCB too":"2.\xA0\u8BF7\u628A\u5BF9\u5E94\u7684\u539F\u7406\u56FE\u6216\u8005PCB\u4E5F\u8FDB\u884C\u91CD\u7F6E\u64CD\u4F5C","The component unique ID will be reset according to the component designator. Please notice:":"\u5C06\u6839\u636E\u5143\u4EF6\u4F4D\u53F7\u91CD\u7F6E\u5143\u4EF6\u552F\u4E00ID\u3002\u91CD\u7F6E\u524D\u8BF7\u6CE8\u610F\uFF1A","2.\xA0Please reset the\xA0corresponding schematic or PCB too, when\xA0reset the schematic\xA0this operation will clear undo/redo\xA0histories":"2.\xA0\u8BF7\u628A\u5BF9\u5E94\u7684\u539F\u7406\u56FE\u6216\u8005PCB\u4E5F\u8FDB\u884C\u91CD\u7F6E\u64CD\u4F5C\uFF0C\u539F\u7406\u56FE\u91CD\u7F6E\u65F6\u5C06\u6E05\u7A7A\u64A4\u9500/\u91CD\u505A\u8BB0\u5F55","Reset component unique ID successfully":"\u91CD\u7F6E\u5143\u4EF6\u552F\u4E00ID\u6210\u529F","Your browser doesn't support or version too low(less than v100) to use the editor, please try below methods to solve:":"\u4F60\u7684\u6D4F\u89C8\u5668\u4E0D\u652F\u6301\u6216\u7248\u672C\u8FC7\u4F4E(\u5C0F\u4E8E v100)\uFF0C\u65E0\u6CD5\u6B63\u5E38\u8FD0\u884C\u7F16\u8F91\u5668\uFF0C\u8BF7\u6309\u7167\u4E0B\u9762\u7684\u65B9\u6CD5\u89E3\u51B3\uFF1A","1. Download the latest desktop client, or use the latest Chrome, Firefox or Edge browser(over than v100), and enable the hardware acceleration at browser setting.  Edge browser:":"1\u3001\u4E0B\u8F7D\u6700\u65B0\u7684\u5BA2\u6237\u7AEF\uFF0C\u6216\u4F7F\u7528\u6700\u65B0\u7684\u8C37\u6B4C\uFF0C\u706B\u72D0\u6216Edge\u6D4F\u89C8\u5668(\u5927\u4E8Ev100)\uFF0C\u5E76\u5728\u6D4F\u89C8\u5668\u8BBE\u7F6E\u91CC\u9762\u5F00\u542F\u786C\u4EF6\u52A0\u901F\u3002Edge\u6D4F\u89C8\u5668\uFF1A","2. Download the latest desktop client. Desktop client:":"2\u3001\u4E0B\u8F7D\u6700\u65B0\u7684\u5BA2\u6237\u7AEF\u3002\u5BA2\u6237\u7AEF\uFF1A","3. If Jiali created an order assistant, please download the latest version (greater than v5.0)":"3\u3001\u5982\u679C\u662F\u5609\u7ACB\u521B\u4E0B\u5355\u5C0F\u52A9\u624B, \u8BF7\u4E0B\u8F7D\u6700\u65B0\u7684\u7248\u672C(\u5927\u4E8Ev5.0)","Board Outline Source":"\u8FB9\u6846\u6765\u6E90","From Keepout Layer":"\u4ECEKeepout\u5C42","From Mechanical Layer 1":"\u4ECE\u673A\u68B0\u5C421","Device Name Source":"\u5668\u4EF6\u540D\u79F0\u6765\u6E90","From comment":"\u4ECEComment","From design Item ID":"\u4ECEDesign Item ID","The selected object contains components, whether to delete it?":"\u9009\u4E2D\u5BF9\u8C61\u4E2D\u542B\u6709\u5143\u4EF6\uFF0C\u662F\u5426\u540C\u65F6\u5220\u9664\uFF1F","Remove From Group":"\u79FB\u51FA\u7EC4\u5408","{0} element removed from the group":"{0}\u4E2A\u5143\u7D20\u4ECE\u7EC4\u5408\u4E2D\u79FB\u51FA","{0} element removed from the group:group{idWithName}":"{0}\u4E2A\u5143\u7D20\u4ECE\u7EC4\u5408\u4E2D\u79FB\u51FA\uFF1A\u7EC4\u5408{idWithName}","The head and tail of the text cannot have more than 15 consecutive numbers, otherwise it will exceed the computer operation range and cause some unpredictable bug!":"\u6587\u672C\u5934\u548C\u5C3E\u4E0D\u80FD\u51FA\u73B0\u8FDE\u7EED15\u4E2A\u4EE5\u4E0A\u6570\u5B57\uFF0C\u5426\u5219\u8D85\u51FA\u8BA1\u7B97\u673A\u8FD0\u7B97\u8303\u56F4\uFF0C\u9020\u6210\u4E00\u4E9B\u65E0\u6CD5\u9884\u6599\u7684bug\uFF01","Create device successfully!":"\u521B\u5EFA\u5668\u4EF6\u6210\u529F\uFF01","Update device failed!":"\u4FEE\u6539\u5668\u4EF6\u5931\u8D25\uFF01","@@component-manager-dialog":{Search:"\u641C\u7D22"},"Datasheet Extract Wizard":"\u89C4\u683C\u4E66\u63D0\u53D6\u5411\u5BFC","Or double click here to add image(<5MB)":"\u6216\u53CC\u51FB\u6DFB\u52A0\u56FE\u7247(<5MB)","Pins Information":"\u5F15\u811A\u4FE1\u606F","Next Step":"\u4E0B\u4E00\u6B65","Drop graphic files here":"\u5728\u6B64\u5904\u653E\u7F6E\u56FE\u5F62\u6587\u4EF6","Please drag graphic file":"\u8BF7\u62D6\u9009\u56FE\u5F62\u7C7B\u6587\u4EF6","Click to cancel loading":"\u5355\u51FB\u53D6\u6D88loading","Use rolling wheels to zoom preview screen":"\u4F7F\u7528\u6EDA\u8F6E\u6765\u7F29\u653E\u9884\u89C8\u753B\u9762","Please add pin information first":"\u8BF7\u5148\u6DFB\u52A0\u5F15\u811A\u4FE1\u606F","The current environment does not support the paste content from the clipboard":"\u5F53\u524D\u73AF\u5883\u4E0D\u652F\u6301\u4ECE\u526A\u8D34\u677F\u7C98\u8D34\u5185\u5BB9","The current environment does not read the permissions of the clipboard":"\u5F53\u524D\u73AF\u5883\u6CA1\u6709\u8BFB\u53D6\u526A\u8D34\u677F\u7684\u6743\u9650","Please copy a picture and paste the paste":"\u8BF7\u590D\u5236\u4E00\u5F20\u56FE\u7247\u518D\u8FDB\u884C\u7C98\u8D34","Image compression failure":"\u56FE\u7247\u538B\u7F29\u5931\u8D25","Please drag or paste image at here":"\u8BF7\u62D6\u62FD\u6216\u7C98\u8D34\u56FE\u7247\u5728\u6B64\u5904","Pins Data without extra