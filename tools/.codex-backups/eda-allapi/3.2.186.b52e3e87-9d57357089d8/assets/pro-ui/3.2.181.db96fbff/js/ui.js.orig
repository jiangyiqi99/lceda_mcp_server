2\u0438\u0441\u044F","Please create board outline first":"\u0421\u0442\u0432\u043E\u0440\u0456\u0442\u044C, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043A\u043E\u043D\u0442\u0443\u0440 \u043F\u043B\u0430\u0442\u0438 \u0437\u043D\u043E\u0432\u0443","Board outlines are not closed.":"\u041A\u043E\u043D\u0442\u0443\u0440 \u043F\u043B\u0430\u0442\u0438 \u043D\u0435 \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u043E.","Rebuild CopperArea":"\u0421\u0442\u0432\u043E\u0440\u0438\u0442\u044C \u043C\u0435\u0442\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044E \u0437\u0430\u043D\u043E\u0432\u043E","Custom Attributes":"\u0410\u0442\u0440\u0438\u0431\u0443\u0442\u0438 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430","Add new parameter":"\u0414\u043E\u0434\u0430\u0442\u0438 \u043D\u043E\u0432\u0438\u0439 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440","Create an account":"\u0421\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u043E\u0431\u043B\u0456\u043A\u043E\u0432\u0438\u0439 \u0437\u0430\u043F\u0438\u0441","Username:":"\u0406\u043C'\u044F \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430:","Password:":"\u041F\u0430\u0440\u043E\u043B\u044C:","Confirm Password:":"\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F \u043D\u043E\u0432\u043E\u0433\u043E \u043F\u0430\u0440\u043E\u043B\u044E:","Email:":"e-mail:","Please read this before you register":"\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0446\u0435 \u043F\u0435\u0440\u0435\u0434 \u0440\u0435\u0433\u0456\u0441\u0442\u0440\u0430\u0446\u0456\u0454\u044E","Lost Password...":"\u041F\u0430\u0440\u043E\u043B\u044C \u0432\u0442\u0440\u0430\u0447\u0435\u043D\u043E...","Find the password using your email":"\u041E\u0434\u0435\u0440\u0436\u0430\u0442\u0438 \u043F\u0430\u0440\u043E\u043B\u044C \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0432\u043B\u0430\u0441\u043D\u043E\u0457 e-mail",Login:"\u0423\u0432\u0456\u0439\u0442\