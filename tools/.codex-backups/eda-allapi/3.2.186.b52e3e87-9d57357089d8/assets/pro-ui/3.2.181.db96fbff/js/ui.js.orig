5\u0440\u0445\u043D\u0456\u0439 \u0448\u0430\u0440",BottomLayer:"\u041D\u0438\u0436\u043D\u0456\u0439 \u0448\u0430\u0440",TopSilkLayer:"\u0412\u0435\u0440\u0445\u043D\u0456\u0439 \u0448\u043E\u0432\u043A\u043E\u0432\u0438\u0439 \u0448\u0430\u0440",BottomSilkLayer:"\u041D\u0438\u0436\u043D\u0456\u0439 \u0448\u043E\u0432\u043A\u043E\u0432\u0438\u0439 \u0448\u0430\u0440",Inner1:"\u0412\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456\u0439 1",Inner2:"\u0412\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456\u0439 2",Inner3:"\u0412\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456\u0439 3",Inner4:"\u0412\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456\u0439 4",Colour:"\u041A\u043E\u043B\u0456\u0440","Width:":"\u0422\u043E\u0432\u0449\u0438\u043D\u0430","Confirm Importing changes information":"\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u0437\u043C\u0456\u043D\u0438 \u0432 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457 \u0449\u043E\u0434\u043E \u0456\u043C\u043F\u043E\u0440\u0442\u0430","Layer Options Settings":"\u0412\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u043E\u043F\u0446\u0456\u0439 \u0448\u0430\u0440\u0443","Layers setting:":"\u0412\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0448\u0430\u0440\u0443:",Configured:"\u041D\u0430\u043B\u0430\u0448\u0442\u043E\u0432\u0430\u043D\u0438\u0439","Layer Name":"\u0406\u043C'\u044F \u0448\u0430\u0440\u0443",TopPasterLayer:"\u0412\u0435\u0440\u0445\u043D\u0456\u0439 \u0448\u0430\u0440 \u0437 \u043F\u0430\u0441\u0442\u0438",BottomPasterLayer:"\u041D\u0438\u0436\u043D\u0456\u0439 \u0448\u0430\u0440 \u0437 \u043F\u0430\u0441\u0442\u0438",TopSolderLayer:"\u0412\u0435\u0440\u0445\u043D\u0456\u0439 \u0437\u0430\u043B\u0443\u0436\u0435\u043D\u0438\u0439 \u0448\u0430\u0440",BottomSolderLayer:"\u041D\u0438\u0436\u043D\u0456\u0439 \u0437\u0430\u043B\u0443\u0436\u0435\u043D\u0438\u0439 \u0448\u0430\u0440",Ratlines:"\u0422\u043E\u0432\u0441\u0442\u0456 \u043B\u0456\u043D\u0456\u0457",BoardOutline:"\u041A\u043E\u043D\u0442\u0443\u0440 \u043F\u043B\u0430\u0442\u0438",All:"\u0412\u0441\u0456",Document:"\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442",Hole:"\u041E\u0442\u0432\u0456\u0440",DRCError:"\u041F\u043E\u043C\u0438\u043B\u043A\u0430 \u0440\u043E\u0437\u0432\u0435\u0434\u0435\u043D\u043D\u044F",Setting:"\u0412\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F","Drawing area":"\u0417\u043E\u043D\u0430 \u043C\u0430\u043B\u044E\u0432\u0430\u043D\u043D\u044F","Export area:":"\u0417\u043E\u043D\u0430 \u0435\u043A\u0441\u043F\u043E\u0440\u0442\u0430","PCB Design Manager":"\u041C\u0435\u043D\u0435\u0434\u0436\u0435\u0440 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u0438\u0445 \u043F\u043B\u0430\u0442","Create Files":"\u0421\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u0444\u0430\u0439\u043B\u0456\u0432","Check your Gerber files carefully before sending them to the factory":"\u0420\u0435\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0432\u0430\u0448 Gerber \u0444\u0430\u0439\u043B, \u043F\u0435\u0440\u0435\u0434 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043A\u043E\u044E \u0439\u043E\u0433\u043E \u043D\u0430 \u0437\u0430\u0432\u043E\u0434","Download free Gerber Viewer (gerbv)":"\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438 \u0431\u0435\u0437\u043A\u043E\u0448\u0442\u043E\u0432\u043D\u0438\u0439 \u043F\u0440\u0435\u0433\u043B\u044F\u0434\u0430\u0447 Gerber \u0444\u0430\u0439\u043B\u0456\u0432 (gerbv)","Design Rule Check":"\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043D\u043E\u0440\u043C \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0438 (DRC)",Item:"\u041F\u0443\u043D\u043A\u0442",Value:"\u0417\u043D\u0430\u0447\u0435\u043D\u043D\u044F",Unit:"\u0411\u043B\u043E\u043A","Track Width":"\u0422\u043E\u0432\u0449\u0438\u043D\u0430 \u0434\u043E\u0440\u0456\u0436\u043A\u0438","Track to Track":"\u0414\u043E\u0440\u0456\u0436\u043A\u0430 \u0434\u043E \u0434\u043E\u0440\u0456\u0436\u043A\u0438","Track to Pad":"\u0414\u043E\u0440\u0456\u0436\u043A\u0430 \u0434\u043E \u043F\u043B\u043E\u0449\u0438\u043D\u043A\u0438","Pad to Pad":"\u041F\u043B\u043E\u0449\u0438\u043D\u043A\u0430 \u0434\u043E \u043F\u043B\u043E\u0449\u0438\u043D\u043A\u0438","Hole to Hole":"\u041E\u0442\u0432\u0456\u0440 \u0434\u043E \u043E\u0442\u0432\u043E\u0440\u0443","Via Hole Size":"\u0420\u043E\u0437\u043C\u0456\u0440 \u043F\u0435\u0440\u0435\u0445\u0456\u0434\u043D\u043E\u0433\u043E \u043E\u0442\u0432\u043E\u0440\u0443","DRC results":"\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 DRC","Update the symbol's package":"\u041F\u043E\u043D\u043E\u0432\u0438\u0442\u0438 \u043F\u0430\u043A\u0435\u0442\u0438 \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0432","Invalid Package":"\u041D\u0435\u0432\u0456\u0440\u043D\u0438\u0439 \u043F\u0430\u043A\u0435\u0442","The package's PAD number is different from the symbol's PIN number, e.g. the diode package's PAD numbers are [A,C] but the symbol's PIN numbers are [1,2]. You just need to change one to fit the other. It is case sensitive!":"\u041F\u0430\u043A\u0435\u0442\u0438 \u0437 \u043D\u043E\u043C\u0435\u0440\u0430\u043C\u0438 \u043F\u043B\u043E\u0449\u0438\u043D\u043E\u043A PAD \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0454 \u043D\u043E\u043C\u0435\u0440\u0430\u043C \u0432\u0438\u0432\u043E\u0434\u0456\u0432 PIN. \u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434: \u043F\u043B\u043E\u0449\u0438\u043D\u043A\u0438 \u0434\u043B\u044F \u0434\u0456\u043E\u0434\u0430 \u0446\u0435 [A,C], \u0430 \u043D\u043E\u043C\u0435\u0440\u0430 \u0432\u0438\u0432\u043E\u0434\u0456\u0432 [1,2]. \u0412\u0430\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0443\u0441\u0443\u043D\u0443\u0442\u0438 \u0446\u044E \u043D\u0435\u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0456\u0441\u0442\u044C. \u041B\u0456\u0442\u0435\u0440\u0438 \u0447\u0443\u0442\u043B\u0438\u0432\u0456 \u0434\u043E \u0440\u0435\u0433\u0456\u0441\u0442\u0440\u0443!","Hotkey Setting":"\u0412\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0433\u0430\u0440\u044F\u0447\u0438\u0445 \u043A\u043B\u0430\u0432\u0456\u0448","Document Type":"\u0442\u0438\u043F \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430",Shortcut:"\u044F\u0440\u043B\u0438\u043A",Function:"\u0444\u0443\u043D\u043A\u0446\u0456\u044F",ALL:"\u0412\u0421\u0406",SCH:"\u0421\u0418\u041C\u0412","Rotate selected objects":"\u041E\u0431\u0435\u0440\u0442\u0430\u0442\u0438 \u0432\u0438\u0431\u0440\u0430\u043D\u0456 \u043E\u0431'\u0454\u043A\u0442\u0438","Scroll Or Move selected left":"\u0417\u0440\u0443\u0448\u0438\u0442\u0438 \u0430\u0431\u043E \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435 \u0437\u043B\u0456\u0432\u0430","Scroll or Move selected right":"\u0417\u0440\u0443\u0448\u0438\u0442\u0438 \u0430\u0431\u043E \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435 \u0437\u043F\u0440\u0430\u0432\u0430","Scroll or Move selected up":"\u0417\u0440\u0443\u0448\u0438\u0442\u0438 \u0430\u0431\u043E \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435 \u0437\u0432\u0435\u0440\u0445\u0443","Scroll or Move selected down":"\u0417\u0440\u0443\u0448\u0438\u0442\u0438 \u0430\u0431\u043E \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435 \u0437\u043D\u0438\u0437\u0443","Select All":"\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u0432\u0441\u0435","Cancel current drawing":"\u0421\u043A\u0430\u0441\u0443\u0432\u0430\u0442\u0438 \u043F\u043E\u0442\u043E\u0447\u043D\u0435 \u043F\u0440\u043E\u043C\u0430\u043B\u044C\u043E\u0432\u0443\u0432\u0430\u043D\u043D\u044F",Save:"\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438","Drag Tool":"\u0406\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u043C\u0430\u043B\u044E\u0432\u0430\u043