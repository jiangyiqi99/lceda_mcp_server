4C\u0431\u043E\u043C\u043D\u0438\u0439","A2 Portrait":"A2 \u043A\u043D\u0438\u0436\u043D\u0438\u0439","A2 Landscape":"A2 \u0430\u043B\u044C\u0431\u043E\u043C\u043D\u0438\u0439","A1 Portrait":"A1 \u043A\u043D\u0438\u0436\u043D\u0438\u0439","A1 Landscape":"A1 \u0430\u043B\u044C\u0431\u043E\u043C\u043D\u0438\u0439",solid:"\u0441\u0443\u0446\u0456\u043B\u044C\u043D\u0430",dashed:"\u0448\u0442\u0440\u0438\u0445\u043E\u0432\u0430\u043D\u0430",dotted:"\u043F\u0443\u043D\u043A\u0442\u0438\u0440\u043D\u0430","Fill Region":"\u0421\u0443\u0446\u0456\u043B\u044C\u043D\u0438\u0439 \u0440\u0435\u0433\u0456\u043E\u043D",Type:"\u0422\u0438\u043F","Browse and search hundreds of thousands of components":"\u041F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0456 \u0437\u043D\u0430\u0439\u0442\u0438 \u0437\u0456 \u0441\u0442\u0430 \u0442\u0438\u0441\u044F\u0447 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432","Report error":"\u041F\u043E\u043C\u0438\u043B\u043A\u0430 \u0437\u0432\u0456\u0442\u0443","Please give us some information to help us find the problem.":"\u0414\u0430\u0439\u0442\u0435, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043D\u0430\u043C \u0434\u0435\u044F\u043A\u0443 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E, \u0449\u043E\u0431 \u043C\u0438 \u043C\u043E\u0433\u043B\u0438 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438 \u0412\u0430\u043C \u0443\u0441\u0443\u043D\u0443\u0442\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443.","Cannot place parts into this document: Schematic Symbols can only be placed into a Schematic; PCB Footprints can only be placed into a PCB.":"\u041D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0440\u043E\u0437\u043C\u0456\u0441\u0442\u0438\u0442\u0438 \u0435\u043B\u0435\u043C\u0435\u043D\u0442 \u0443 \u0446\u044C\u043E\u043C\u0443 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0456: \u0421\u0445\u0435\u043C\u043E\u0442\u0435\u0445\u043D\u0456\u0447\u043D\u0456 \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0438 \u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0440\u043E\u0441\u043C\u0456\u0441\u0442\u0438\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0430 \u0441\u0445\u0435\u043C\u0456; \u0435\u043B\u0435\u043C\u0435\u043D\u0442 \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u043E\u0457 \u043F\u043B\u0430\u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0430 \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u0456\u0439 \u043F\u043B\u0430\u0442\u0456.","Save it as a favorite part":"\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0439\u043E\u0433\u043E \u044F\u043A \u043E\u0431\u0440\u0430\u043D\u0438\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442","Only logged-in users can save this component as a Favorite Part but guest (Anonymous) users can place this component into their design directly. Would you like to place this component now?":"\u0422\u0456\u043B\u044C\u043A\u0438 \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043E\u0432\u0430\u043D\u0456 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456 \u043C\u043E\u0436\u0443\u0442\u044C \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456 \u044F\u043A \u043E\u0431\u0440\u0430\u043D\u0456, \u0430 \u0433\u043E\u0441\u0442\u0456 (\u0430\u043D\u043E\u043D\u0456\u043C\u0438) \u043C\u043E\u0436\u0443\u0442\u044C \u0442\u0456\u043B\u044C\u043A\u0438 \u0431\u0435\u0437\u043F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044C\u043E \u0440\u043E\u0437\u043C\u0456\u0449\u0443\u0432\u0430\u0442\u0438 \u0457\u0445 \u043D\u0430 \u0441\u0432\u043E\u0457\u0445 \u0441\u0445\u0435\u043C\u0430\u0445. \u0411\u0430\u0436\u0430\u0454\u0442\u0435 \u0437\u0430\u0440\u0430\u0437 \u0440\u043E\u0437\u043C\u0456\u0441\u0442\u0438\u0442\u0438 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442?","Find libs":"\u041F\u043E\u0448\u0443\u043A \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0438","My Projects":"\u041C\u0456\u0439 \u043F\u0440\u043E\u0435\u043A\u0442","My Parts":"\u041C\u043E\u0457 \u0431\u043B\u043E\u043A\u0438","System IC":"\u0421\u0438\u0441\u0442\u0435\u043C\u043D\u0430 \u0406\u041C\u0421","Favorite Parts":"\u041E\u0431\u0440\u0430\u043D\u0456 \u0431\u043B\u043E\u043A\u0438","Shared With Me":"\u041F\u043E\u0434\u0456\u043B\u0438\u0442\u0438\u0441\u044F \u0437\u0456 \u043C\u043D\u043E\u044E",Preview:"\u041F\u0440\u0435\u0432'\u044E",Close:"\u0417\u0430\u043A\u0440\u0438\u0442\u0438",Open:"\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0438",Collapse:"\u0417\u0433\u043E\u0440\u043D\u0443\u0442\u0438","Toggle toolbar":"\u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u043F\u0430\u043D\u0435\u043B\u044C \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432","Toggle left bar":"\u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u043B\u0456\u0432\u0443 \u043F\u0430\u043D\u0435\u043B\u044C","Toggle right bar":"\u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u0438 \u043F\u0440\u0430\u0432\u0443 \u043F\u0430\u043D\u0435\u043B\u044C",Reload:"\u041F\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F","Mouse-X":"\u041A\u0443\u0440\u0441\u043E\u0440 \u043F\u043E X","Mouse-Y":"\u041A\u0443\u0440\u0441\u043E\u0440 \u043F\u043E Y",Yes:"\u0422\u0430\u043A",No:"\u041D\u0456",OK:"\u041E\u041A",Cancel:"\u0412\u0456\u0434\u043C\u0456\u043D\u0438\u0442\u0438","Ask a question":"\u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u043F\u0438\u0442\u0430\u043D\u043D\u044F","Click to Share my work":"\u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C, \u0449\u043E\u0431 \u043F\u043E\u0434\u0456\u043B\u0438\u0442\u0438\u0441\u044F \u0441\u0432\u043E\u0457\u043C\u0438 \u043D\u0430\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043D\u043D\u044F\u043C\u0438","Go to my page":"\u041F\u0435\u0440\u0435\u0439\u0442\u0438 \u043D\u0430 \u0441\u0432\u043E\u044E \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0443","Bus entry":"\u0412\u0438\u0432\u043E\u0434\u0438 \u0448\u0438\u043D\u0438",Filter:"\u0424\u0456\u043B\u044C\u0442\u0440",Check:"\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C","Guest Project":"\u0413\u043E\u0441\u0442\u044C\u043E\u0432\u0438\u0439 \u043F\u0440\u043E\u0435\u043A\u0442","Insert into":"\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443","Copy the contents of this box into a text editor, then save the file. Paste the edited text back into this box and click Apply to update the display.":"\u0421\u043A\u043E\u043F\u0456\u044E\u0439\u0442\u0435 \u0432\u043C\u0456\u0441\u0442 \u0446\u044C\u043E\u0433\u043E \u043F\u043E\u043B\u044F \u0432 \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u0438\u0439 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440, \u043F\u043E\u0442\u0456\u043C \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044C \u0444\u0430\u0439\u043B. \u0412\u0441\u0442\u0430\u0432\u0442\u0435 \u0432\u0456\u0434\u0440\u0435\u0434\u0430\u0433\u043E\u0432\u0430\u043D\u0438\u0439 \u0442\u0435\u043A\u0441\u0442 \u0437\u043D\u043E\u0432\u0443 \u0432 \u043F\u043E\u043B\u0435 \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u043A\u043D\u043E\u043F\u043A\u0443 \u0417\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438 \u0434\u043B\u044F \u043E\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0435\u043A\u0440\u0430\u043D\u0443.","EasyEDA format":"\u0424\u043E\u0440\u043C\u0430\u0442 EasyEDA","Copy the contents of this box into a text editor, then save the file with a .svg extension. You can edit it in Inkscape or open it in your browser.":"\u0421\u043A\u043E\u043F\u0456\u044E\u0439\u0442\u0435 \u0432\u043C\u0456\u0441\u0442 \u0446\u044C\u043E\u0433\u043E \u043F\u043E\u043B\u044F \u0432 \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u0438\u0439 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440, \u043F\u043E\u0442\u0456\u043C \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044C \u0444\u0430\u0439\u043B \u0437 \u0440\u043E\u0437\u0448\u0438\u0440\u0435\u043D\u043D\u044F\u043C .svg . \u041F\u043E\u0442\u0456\u043C \u0439\u043E\u0433\u043E \u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0431\u0443\u0434\u0435 \u0432\u0456\u0434\u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u0442\u0438 \u0432 Inkscape \u0430\u0431\u043E \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0443 \u0432\u0430\u0448\u043E\u043C\u0443 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0456.","SVG format":"\u0424\u043E\u0440\u043C\u0430\u0442 SVG","SVG File":"\u0424\u0430\u0439\u043B SVG","Description should be no more than 250 letters":"\u041E\u043F\u0438\u0441 \u043F\u043E\u0432\u0438\u043D\u0435\u043D \u043C\u0430\u0442\u0438 \u043D\u0435 \u0431\u0456\u043B\u044C\u0448 250 \u043B\u0438\u0441\u0442\u0456\u0432\u043E\u043A","The file save operation has timed out. Try again and check your Internet connection.":"\u041E\u043F\u0435\u0440\u0430\u0446\u0456\u044F \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F \u0444\u0430\u0439\u043B\u0443 \u0437\u0430\u0442\u044F\u0433\u043D\u0443\u043B\u0430\u0441\u044C. \u041F\u043E\u0432\u0442\u043E\u0440\u0456\u0442\u044C \u0457\u0457 \u043F\u0456\u0437\u043D\u0456\u0448\u0435 \u0456 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0432\u0430\u0448\u0435, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0456\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0437'\u0454\u0434\u043D\u0430\u043D\u043D\u044F.","Export Netlist":"\u0415\u043A\u0441\u043F\u043E\u0440\u0442 \u043F\u0435\u0440\u0435\u043B\u0456\u043A\u0443 \u0437'\u0454\u0434\u043D\u0430\u043D\u043D\u044C","Coming soon":"\u041D\u0435\u0437\u0430\u0431\u0430\u0440\u043E\u043C \u0437'\u044F\u0432\u0438\u0442\u044C\u0441\u044F","No tool":"\u041D\u0435\u043C\u0430 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430","Help us translate into your language":"\u0414\u043E\u043F\u043E\u043C\u043E\u0436\u0456\u0442\u044C \u043D\u0430\u043C \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0441\u0442\u0438 \u043D\u0430 \u0432\u0430\u0448\u0443 \u043C\u043E\u0432\u0443",Pad:"\u041F\u043B\u043E\u0449\u0438\u043D\u043A\u0430","Via/Hole":"\u041F\u0435\u0440\u0435\u0445\u0456\u0434/\u041E\u0442\u0432\u0456\u0440","PCB Layers":"\u0428\u0430\u0440 \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u0438\u0445 \u043F\u0440\u043E\u0432\u0456\u0434\u043D\u0438\u043A\u0456\u0432","Order PCB":"\u0417\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u043E\u0457 \u043F\u043B\u0430\u0442\u0438",Share:"\u041D\u0430\u0434\u0430\u0442\u0438",Free:"\u0412\u0456\u043B\u044C\u043D\u0435",Small:"\u041C\u0430\u043B\u0438\u0439",Medium:"\u0421\u0435\u0440\u0435\u0434\u043D\u0456\u0439",Big:"\u0412\u0435\u043B\u0438\u043A\u0438\u0439",Embed:"\u0412\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0439",URL:"\u0406\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u043F\u043E\u0441\u0438\u043B\u0430\u043D\u043D\u044F",BBCode:"BB \u043A\u043E\u0434",PNG:"\u0424\u043E\u0440\u043C\u0430\u0442 PNG","Exporting as":"\u0415\u043A\u0441\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u044F\u043A","Exporting as image":"\u0415\u043A\u0441\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u044F\u043A \u043C\u0430\u043B\u044E\u043D\u043E\u043A","Exporting as {0}SVG{1} file.":"\u0415\u043A\u0441\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u044F\u043A {0}SVG{1} \u0444\u0430\u0439\u043B.","Exporting as pdf is recommended: pdf gives good quality printed output and a small file size.":"\u0415\u043A\u0441\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u044F\u043A pdf \u0444\u0430\u0439\u043B, \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u043C\u043E: \u0432\u0456\u043D \u043C\u0430\u0454 \u0445\u043E\u0440\u043E\u0448\u0443 \u044F\u043A\u0456\u0441\u0442\u044C \u0434\u0440\u0443\u043A\u0443 \u043D\u0430 \u043F\u0440\u0438\u043D\u0442\u0435\u0440\u0456 \u045