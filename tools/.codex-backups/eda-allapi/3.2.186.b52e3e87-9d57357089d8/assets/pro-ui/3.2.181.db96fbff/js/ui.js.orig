\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u044F\u043A \u0441\u0445\u0435\u043C\u0443","Save as a schematic Lib":"\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u044F\u043A \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0443 \u0437\u0456 \u0441\u0445\u0435\u043C","Save as a spice Symbol":"\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u044F\u043A \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0438\u0439 \u0441\u0438\u043C\u0432\u043E\u043B","Save as a spice subckt":"\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u044F\u043A \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u044C\u043D\u0438\u0439 \u0431\u043B\u043E\u043A","YOU MUST CREATE A SPICE SYMBOL WITH EXACTLY THE SAME NAME AS THIS SUBCKT":"\u0412\u0410\u041C \u041F\u041E\u0422\u0420\u0406\u0411\u041D\u041E \u0421\u0422\u0412\u041E\u0420\u0418\u0422\u0418 \u0421\u041F\u0415\u0426\u0406\u0410\u041B\u042C\u041D\u0418\u0419 \u0421\u0418\u041C\u0412\u041E\u041B \u0417 \u0422\u0418\u041C \u0416\u0415 \u0418\u041C'\u042F\u041C, \u0429\u041E \u0419 \u0426\u0415\u0419 \u0411\u041B\u041E\u041A","Save as a PCB file":"\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u044F\u043A \u0444\u0430\u0439\u043B \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u043E\u0457 \u043F\u043B\u0430\u0442\u0438","Save as a PCB Lib":"\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u044F\u043A \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0443 \u0437 \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u0438\u0445 \u043F\u043B\u0430\u0442","Title:":"\u041D\u0430\u0437\u0432\u0430:","Share:":"\u041D\u0430\u0434\u0430\u043D\u043D\u044F:","Visibility:":"\u0412\u0438\u0434\u0438\u043C\u0456\u0441\u0442\u044C:","Allow Comments:":"\u0414\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0438 \u043A\u043E\u043C\u0435\u043D\u0442\u0443\u0432\u0430\u0442\u0438:","Public (Anyone can see this project but only you can modify it.)":"\u041F\u0443\u0431\u043B\u0438\u0447\u043D\u0438\u0439 (\u0422\u0456\u043B\u044C\u043A\u043E \