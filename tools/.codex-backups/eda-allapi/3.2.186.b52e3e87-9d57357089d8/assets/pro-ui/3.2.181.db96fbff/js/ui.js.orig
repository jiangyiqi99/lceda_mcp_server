43E\u0440\u043E\u0442\u043A\u0438\u0439 \u0442\u0430 \u0434\u0435\u0442\u0430\u043B\u0456\u0437\u043E\u0432\u0430\u043D\u0438\u0439","Please visit our {0}Support Home{1} page for more information":"\u041F\u0440\u0435\u0439\u0434\u0456\u0442\u044C, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043D\u0430 {0}\u0414\u043E\u043C\u0430\u0448\u043D\u044E \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0443 \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0438{1}, \u0449\u043E\u0431 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457",Submit:"\u0412\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438","Verify the packages":"\u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u043F\u0430\u043A\u0435\u0442\u0438",Clone:"\u041A\u043B\u043E\u043D\u0443\u0432\u0430\u0442\u0438","Reload parts":"\u041F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438 \u0431\u043B\u043E\u043A\u0438",Layers:"\u0428\u0430\u0440\u0438","Language:":"\u041C\u043E\u0432\u0430:","Display Name:":"\u0412\u0456\u0434\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u043D\u0435 \u0456\u043C'\u044F:","HotKey Sync:":"\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u0433\u0430\u0440\u044F\u0447\u0438\u0445 \u043A\u043B\u0430\u0432\u0456\u0448:","Document Recovery Setting:":"\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F \u0440\u0435\u0437\u0435\u0440\u0432\u0443\u0432\u0430\u043D\u043D\u044F:","Maximum backup level:":"\u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0438\u0439 \u0440\u0456\u0432\u0435\u043D\u044C \u0440\u0435\u0437\u0435\u0440\u0432\u0443\u0432\u0430\u043D\u043D\u044F:","Auto backup(minutes):":"\u0410\u0432\u0442\u043E\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F (\u0443 \u0445\u0432\u0438\u043B\u0438\u043D\u0430\u0445)","Save to Server":"\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0456","Load from Server":"\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438 \u0437 \u0441\u0435\u0440\u0432\u0435\u0440\u0430","Style:":"\u0421\u0442\u0438\u043B\u044C:","Picture:":"\u041C\u0430\u043B\u044E\u043D\u043E\u043A:","Pin Names:":"\u041D\u0430\u0437\u0432\u0438 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0456\u0432:",Annotate:"\u0410\u0432\u0442\u043E\u0440\u0441\u0442\u0432\u043E",Scope:"\u0421\u0444\u0435\u0440\u0430 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043D\u043D\u044F","Active Schematic only":"\u0422\u0456\u043B\u044C\u043A\u043E \u0430\u043A\u0442\u0438\u0432\u043D\u0430 \u0441\u0445\u0435\u043C\u0430","All Opened Schematics":"\u0412\u0441\u0456 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u0441\u0445\u0435\u043C\u044B",Method:"\u041C\u0435\u0442\u043E\u0434","Re-annotate all":"\u041F\u0440\u0438\u0441\u0432\u043E\u0457\u0442\u0438 \u0430\u0432\u0442\u043E\u0440\u0441\u0442\u0432\u043E \u0434\u043B\u044F \u0432\u0441\u0456\u0445","Keep existing annotation":"\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0456\u0441\u043D\u0443\u044E\u0447\u0435 \u0430\u0432\u0442\u043E\u0440\u0441\u0442\u0432\u043E",Direction:"\u041D\u0430\u043F\u0440\u044F\u043C\u043E\u043A",Rows:"\u0420\u044F\u0434\u043A\u0456\u0432",Cols:"\u0421\u0442\u043E\u0432\u0431\u0446\u0456\u0432",Reset:"\u0417\u043A\u0438\u0434\u0430\u043D\u043D\u044F","Order...":"\u0417\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F...","Order your PCB from EasyEDA":"\u0417\u0430\u043C\u043E\u0432\u0438\u0442\u0438 \u0432\u0430\u0448\u0443 \u043F\u043B\u0430\u0442\u0443 \u0437 EasyEDA","PCB Qty.":"\u041A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043F\u043B\u0430\u0442","PCB Thickness":"\u0422\u043E\u0432\u0449\u0438\u043D\u0430 \u043F\u043B\u0430\u0442\u0438","PCB Dimension":"\u0420\u043E\u0437\u043C\u0456\u0440 \u043F\u043B\u0430\u0442\u0438","Automatic calculation":"\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u0438\u0439 \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043E\u043A","PCB Color":"\u041A\u043E\u043B\u0456\u0440 \u043F\u043B\u0430\u0442\u0438",Green:"\u0417\u0435\u043B\u0435\u043D\u0438\u0439",White:"\u0411\u0456\u043B\u0438\u0439",Blue:"\u0421\u0438\u043D\u0456\u0439",Red:"\u0427\u0435\u0440\u0432\u043E\u043D\u0438\u0439",Yellow:"\u0416\u0435\u0432\u0442\u0438\u0439",Black:"\u0427\u043E\u0440\u043D\u0438\u0439","Surface Finish":"\u041E\u0431\u0440\u043E\u0431\u043A\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456",Hasl:"\u041F\u0440\u0438\u043F\u0456\u0439","Hasl(Lead Free)":"\u041F\u0440\u0438\u043F\u0456\u0439 (\u0431\u0435\u0437 \u0441\u0432\u0438\u043D\u0446\u044E)","Open Project":"\u0412\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0439 \u043F\u0440\u043E\u0435\u043A\u0442","E-Test":"\u0415\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0456 \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F","Shipping Cost":"\u0412\u0430\u0440\u0442\u0456\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0441\u0438\u043B\u043A\u0438","Cost Estimate":"\u041A\u043E\u0448\u0442\u043E\u0440\u0438\u0441 \u0432\u0438\u0442\u0440\u0430\u0442","Actual cost will be confirmed by email.":"\u0410\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u0430 \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044C \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u0430 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u044E \u043F\u043E\u0448\u0442\u043E\u044E","Shipping information":"\u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F \u043F\u0440\u043E \u043F\u0435\u0440\u0435\u0441\u0438\u043B\u043A\u0443",Address:"\u0410\u0434\u0440\u0435\u0441\u0430","ZIP/Post code":"\u041F\u043E\u0447\u0442\u043E\u0432\u0438\u0439 \u0456\u043D\u0434\u0435\u043A\u0441",City:"\u041C\u0456\u0441\u0442\u043E",Country:"\u041A\u0440\u0430\u0457\u043D\u0430","Tel.":"\u0422\u0435\u043B\u0435\u0444\u043E\u043D","After filling out the form above, we will email you with (i) the results of the design rule check, (ii) a quote and (iii) a payment link using Paypal. Shipping is normally one week from receipt of payment.":"\u041F\u0456\u0441\u043B\u044F \u0437\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u043D\u044F \u0432\u043A\u0430\u0437\u0430\u043D\u043E\u0457 \u0432\u0438\u0449\u0435 \u0444\u043E\u0440\u043C\u0438, \u043C\u0438 \u0432\u0438\u0448\u043B\u0435\u043C\u043E \u0412\u0430\u043C: (I) \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0438 \u043F\u0440\u043E\u0435\u043A\u0442\u043D\u0438\u0445 \u043D\u043E\u0440\u043C, (II) \u043A\u0432\u043E\u0442\u0438 \u0456 (III) \u043F\u043E\u0441\u0438\u043B\u0430\u043D\u043D\u044F \u0434\u043B\u044F \u043E\u043F\u043B\u0430\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 Paypal. \u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430, \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u0437\u0434\u0456\u0439\u0441\u043D\u044E\u0454\u0442\u044C\u0441\u044F \u0447\u0435\u0440\u0435\u0437 \u0442\u0438\u0436\u0434\u0435\u043D\u044C \u043F\u0456\u0441\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u044F \u043E\u043F\u043B\u0430\u0442\u0438.","Restore All Default Shortcuts":"\u0412\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u0438 \u0432\u0441\u0456 \u044F\u0440\u043B\u0438\u043A\u0438 \u0437\u0430 \u0437\u0430\u043C\u043E\u0432\u0447\u0443\u0432\u0430\u043D\u043D\u044F\u043C","Save Changes":"\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0437\u043C\u0456\u043D\u0438","To connect electrical elements, please use Wire (W hotkey) and not Line (L hotkey).":"\u0414\u043B\u044F \u0437'\u0454\u0434\u043D\u0430\u043D\u043D\u044F \u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0438\u0445 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0456\u0432, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435 \u041F\u0440\u043E\u0432\u0456\u0434 (\u043A\u043B\u0430\u0432\u0456\u0448\u0430 W) \u0456 \u043D\u0435 \u041B\u0456\u043D\u0456\u044F (\u043A\u043B\u0430\u0432\u0456\u0448\u0430 L).",Confirmation:"\u041F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F",Alert:"\u0422\u0440\u0438\u0432\u043E\u0433\u0430",Information:"\u0406\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F",information:"\u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F",Prompt:"\u041F\u0456\u0434\u043A\u0430\u0437\u043A\u0430",Error:"\u041F\u043E\u043C\u0438\u043B\u043A\u0430",error:"\u043F\u043E\u043C\u0438\u043B\u043A\u0430","error!":"\u043F\u043E\u043C\u0438\u043B\u043A\u0430!",Warning:"\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0435\u043D\u043D\u044F","Imported ok!":"\u0406\u043C\u043F\u043E\u0440\u0442 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E!","Some changes have not been saved.":"\u0414\u0435\u044F\u043A\u0456 \u0437\u043C\u0456\u043D\u0438 \u043D\u0435 \u0431\u0443\u043B\u043E \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E.","Your file hasn't been saved. Are you sure you want to close it?":"\u0412\u0430\u0448 \u0444\u0430\u0439\u043B \u043D\u0435 \u0431\u0443\u043B\u043E \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E. \u0412\u0438 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0456, \u0449\u043E \u0445\u043E\u0447\u0435\u0442\u0435 \u0439\u043E\u0433\u043E \u0437\u0430\u043A\u0440\u0438\u0442\u0438?","load failure !":"\u043F\u043E\u043C\u0438\u043B\u043A\u0430 \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F !","error info":"\u0456\u043D\u0444. \u043F\u0440\u043E \u043F\u043E\u043C\u0438\u043B\u043A\u0443","error information":"\u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044F \u043F\u0440\u043E \u043F\u043E\u043C\u0438\u043B\u043A\u0443","Guest can't create a new project. Please login!":"\u0413\u0456\u0441\u0442\u044C \u043D\u0435 \u043C\u043E\u0436\u0435 \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438 \u043D\u043E\u0432\u0456 \u043F\u0440\u043E\u0435\u043A\u0442\u0438, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u0443\u0439\u0442\u0435\u0441\u044F!","Please create a project before you do this!":"\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0441\u0442\u0432\u043E\u0440\u0456\u0442\u044C \u043F\u0440\u043E\u0435\u043A\u0442, \u043F\u0435\u0440\u0435\u0434 \u0442\u0438\u043C \u044F\u043A \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0446\u0435!","Add Part success":"\u0414\u043E\u0434\u0430\u0432\u0430\u043D\u043D\u044F \u0431\u043B\u043E\u043A\u0443 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E","Click the new part and then edit it !":"\u0421\u0442\u0432\u043E\u0440\u0456\u0442\u044C \u043D\u043E\u0432\u0438\u0439 \u0431\u043B\u043E\u043A, \u0430 \u043F\u043E\u0442\u0456\u043C \u0440\u0435\u0434\u0430\u0433\u0443\u0439\u0442\u0435 \u0439\u043E\u0433\u043E !","Delete my work":"\u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438 \u0432\u043B\u0430\u0441\u043D\u0456 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0438","Do you confirm this?":"\u0412\u0438 \u0437\u0433\u0456\u0434\u043D\u0456 \u0437 \u0446\u0438\u043C?","Successfully deleted!":"\u0423\u0441\u043F\u0456\u0448\u043D\u043E \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u043E !","Cloning success!":"\u041A\u043B\u043E\u043D\u0443\u0432\u0430\u043D\u043D\u044F \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E !","Your title is too short!":"\u0432\u0430\u0448\u0430 \u043D\u0430\u0437\u0432\u0430 \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u0430!","Remove this part":"\u0432\u0438\u0434\u0438\u043B\u0438\u0442\u0438 \u0446\u044E \u0447\u0430\u0441\u0442\u0438\u043D\u0443","Find and Jump to ...":"\u0417\u043D\u0430\u0439\u0442\u0438 \u0442\u0430 \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u0434\u043E...","Please type the prefix, such as U1, R1, C1":"\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043D\u0430\u0434\u0440\u0443\u043A\u0443\u0439\u0442\u0435 \u043F\u0440\u0435\u0444\u0456\u043A\u0441, \u0442\u0438\u043F\u0443 U1,R1,C1","Zoom as 1:1, you can print it and then create artwork for etching the PCB.":"\u0417\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043D\u044F 1:1, \u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0434\u0440\u0443\u043A\u0443\u0432\u0430\u0442\u0438 \u0439\u043E\u0433\u043E, \u0442\u0430 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0448\u0430\u0431\u043B\u043E\u043D \u0434\u043B\u044F \u0442\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u043E\u0457 \u043F\u043B\u0430\u0442\u0438.","Exporting your works!":"\u0412\u0430\u0448\u0456 \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u0438 \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u043E\u0432\u0430\u043D\u043E!","Guests can't import a file. Please login!":"\u0413\u043E\u0441\u0442\u0456 \u043D\u0435 \u043C\u043E\u0436\u0443\u0442\u044C \u0456\u043C\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u0444\u0430\u0439\u043B\u0438, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u0443\u0439\u0442\u0435\u0441\u044C!","Please create a project before you import a file!":"\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0441\u0442\u0432\u043E\u0440\u0456\u0442\u044C \u043F\u0440\u043E\u0435\u043A\u0442, \u043F\u0435\u0440\u0448 \u043D\u0456\u0436 \u0456\u043C\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u0444\u0430\u0439\u043B!","Import your LTspice file!":"\u0406\u043C\u043F\u043E\u0440\u0442 \u0432\u0430\u0448\u043E\u0433\u043E \u0444\u0430\u0439\u043B\u0430 \u0432 \u0444\u043E\u0440\u043C\u0430\u0442\u0456 LTspice!","Saved successfully!":"\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E !","Can not place parts into this document.":"\u0412 \u0446\u044C\u043E\u043C\u0443 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0456 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0440\u043E\u0437\u043C\u0456\u0449\u0443\u0432\u0430\u0442\u0438 \u0431\u043B\u043E\u043A\u0438.","User Package":"\u041F\u0430\u043A\u0435\u0442 \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430","System Package":"\u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0438\u0439 \u043F\u0430\u043A\u0435\u0442","File error":"\u041F\u043E\u043C\u0438\u043B\u043A\u0430 \u0444\u0430\u0439\u043B\u0430","Please save your file first!":"\u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044C, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0432\u0430\u0448 \u0444\u0430\u0439\u043B!","Email address is too short!":"\u0410\u0434\u0440\u0435\u0441\u0430 \u0435\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0457 \u043F\u043E\u0448\u0442\u044B \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u0430!","You have not selected a file to upload.":"\u0412\u0438 \u043D\u0435 \u043E\u0431\u0440\u0430\u043B\u0438 \u0444\u0430\u0439\u043B \u0434\u043B\u044F \u0432\u0438\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F.",Update:"\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u0438","No changes":"\u0431\u0435\u0437 \u0437\u043C\u0456\u043D","PCB is the same as SCH!":"\u0414\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u0430 \u043F\u043B\u0430\u0442\u0430 \u0442\u0435 \u0436 \u0441\u0430\u043C\u0435 \u0449\u043E \u0439 \u0441\u0445\u0435\u043C\u0430!","Only public files can be shared":"\u041D\u0430\u0434\u0430\u0432\u0430\u0442\u0438 \u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0443\u0431\u043B\u0456\u0447\u043D\u0456 \u0444\u0430\u0439\u043B\u0438","Conversion to PCB has failed!":"\u041A\u043E\u043D\u0432\u0435\u0440\u0442\u0430\u0446\u0456\u044F \u0432 \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u0443 \u043F\u043B\u0430\u0442\u0443 \u043D\u0435 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E!","Your username is too short!":"\u0412\u0430\u0448\u0435 \u0456\u043C'\u044F \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u0435!","Your password is too short, it must be more than 6 characters!":"\u0412\u0430\u0448 \u043F\u0430\u0440\u043E\u043B\u044C \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439, \u0432\u0456\u043D \u043F\u043E\u0432\u0438\u043D\u0435\u043D \u043C\u0456\u0441\u0442\u0438\u0442\u0438 \u043D\u0435 \u043C\u0435\u043D\u0448 \u043D\u0456\u0436 6 \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0432!","Conflicting shortcut:":"\u041A\u043E\u043D\u0444\u043B\u0456\u043A\u0442 \u044F\u0440\u043B\u0438\u043A\u0456\u0432:","There is an empty PCB file. Please first run Convert Project To PCB... from the schematic":"\u0424\u0430\u0439\u043B \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u043E\u0457 \u043F\u043B\u0430\u0442\u0438 \u043F\u043E\u0440\u043E\u0436\u043D\u0456\u0439. \u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0432\u0438\u043A\u043E\u043D\u0430\u0439\u0442\u0435, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u041A\u043E\u043D\u0432\u0435\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u043F\u0440\u043E\u0435\u043A\u0442 \u0432 \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u0443 \u043F\u043B\u0430\u0442\u0443... \u0437\u0456 \u0441\u0445\u0435\u043C\u0438","This file has been modified, are you sure you want to run this simulation before saving it first?":"\u0426\u0435\u0439 \u0444\u0430\u0439\u043B \u0431\u0443\u043B\u043E \u0437\u043C\u0456\u043D\u0435\u043D\u043E, \u0412\u0438 \u0443\u043F\u0435\u0432\u043D\u0435\u043D\u0456 \u0449\u043E \u0445\u043E\u0447\u0435\u0442\u0435 \u0432\u0438\u043A\u043E\u043D\u0430\u0442\u0438 \u043C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u043D\u043D\u044F? \u041C\u043E\u0436\u0435 \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0439\u043E\u0433\u043E?","Please enter the Maximum Timestep!":"\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0432\u0432\u0435\u0434\u0456\u0442\u044C \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0438\u0439 \u0447\u0430\u0441\u043E\u0432\u0438\u0439 \u043A\u0440\u043E\u043A!","Please enter the Stop Time!":"\u0412\u0432\u0435\u0434\u0456\u0442\u044C, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0447\u0430\u0441 \u0437\u0443\u043F\u0438\u043D\u043A\u0438!","All of these fields are needed.":"\u0423\u0441\u0456 \u0446\u0456 \u043F\u043E\u043B\u044F \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438.","Either your spice netlist is too big or the server is busy. Please try again later.":"\u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0439 \u0412\u0430\u043C\u0438 \u0441\u043F\u0438\u0441\u043E\u043A \u0437'\u0454\u0434\u043D\u0430\u043D\u043D\u044C \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u0438\u0439, \u0430\u0431\u043E \u0436 \u0441\u0435\u0440\u0432\u0435\u0440 \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0439. \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0441\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043F\u0456\u0437\u043D\u0456\u0448\u0435.","Your spice netlist is too big! Try breaking your circuit into smaller simulatable blocks.":"\u0412\u0430\u0448 \u0441\u043F\u0438\u0441\u043E\u043A \u0437'\u0454\u0434\u043D\u0430\u043D\u043D\u044C \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u0438\u0439! \u0421\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0440\u043E\u0437\u0434\u0456\u043B\u0438\u0442\u0438 \u0432\u0430\u0448\u0443 \u0441\u0445\u0435\u043C\u0443 \u043D\u0430 \u0431\u0456\u043B\u044C\u0448 \u0434\u0440\u0456\u0431\u043D\u0456 \u0431\u043B\u043E\u043A\u0438 \u0434\u043B\u044F \u043C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u043D\u043D\u044F.","Too many users in simulation. Please try again later!":"\u0414\u0443\u0436\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0456\u0432 \u0432\u0438\u043A\u043E\u043D\u0443\u044E\u0442\u044C \u043C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u043D\u043D\u044F. \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043F\u043E\u0432\u0442\u043E\u0440\u0456\u0442\u044C \u0441\u043F\u0440\u043E\u0431\u0443 \u043F\u0456\u0437\u043D\u0456\u0448\u0435.","Your simulation results are too large! Try reducing the total simulation time (Stop Time - Start Time), increasing the maximum time step, removing some of your probes or breaking your circuit into smaller simulatable blocks.":"\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438 \u0432\u0430\u0448\u043E\u0433\u043E \u043C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u043D\u043D\u044F \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u0456. \u0421\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0437\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u0438 \u0437\u0430\u0433\u0430\u043B\u044C\u043D\u0438\u0439 \u0447\u0430\u0441 \u043C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u043D\u043D\u044F (\u0427\u0430\u0441 \u0437\u0430\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u044F - \u0427\u0430\u0441 \u043F\u043E\u0447\u0430\u0442\u043A\u0443), \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u0437\u0431\u0456\u043B\u044C\u0448\u0456\u0442\u044C \u0447\u0430\u0441\u043E\u0432\u0438\u0439 \u043A\u0440\u043E\u043A, \u0437\u043C\u0435\u043D\u044C\u0448\u0456\u0442\u044C \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0438\u0445 \u0442\u043E\u0447\u043E\u043A, \u0430\u0431\u043E \u0440\u043E\u0437\u0434\u0456\u043B\u0456\u0442\u044C \u0441\u0445\u0435\u043C\u0443 \u043D\u0430 \u0431\u0456\u043B\u044C\u0448 \u0434\u0440\u0456\u0431\u043D\u0456 \u0447\u0430\u0441\u0442\u0438\u043D\u0438 \u0434\u043B\u044F \u043C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u043D\u043D\u044F.","Demo accounts don't support simulation, please login first":"\u0414\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0456\u0439\u043D\u0438\u0439 \u0430\u043A\u043A\u0430\u0443\u043D\u0442 \u043D\u0435 \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454 \u043C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u043D\u043D\u044F, \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u0443\u0432\u0430\u0442\u0438\u0441\u044C","Some unexpected error has happened, please contact us.(http://easyeda.com/cms_files_about-us.htm#ContactUs)":"\u0422\u0440\u0430\u043F\u0438\u043B\u0430\u0441\u044F \u043D\u0435\u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0435\u043D\u0430 \u043F\u043E\u043C\u0438\u043B\u043A\u0430, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0442\u0435 \u043F\u043E \u0446\u0435 \u043D\u0430 (http://easyeda.com/cms_files_about-us.htm#ContactUs)","The schematic is showing errors, please check the simulation report carefully!":"\u0421\u0445\u0435\u043C\u0430 \u043F\u043E\u043A\u0430\u0437\u0443\u0454 \u043F\u043E\u043C\u0438\u043B\u043A\u0443, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0431\u0456\u043B\u044C\u0448 \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u043E \u0437\u0432\u0456\u0442 \u0437 \u043C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u043D\u043D\u044F","Simulation too long, maybe your schematic is too complex.":"\u041C\u043E\u0434\u0435\u043B\u044E\u0432\u0430\u043D\u043D\u044F \u0437\u0430\u0442\u044F\u0433\u043B\u043E\u0441\u044F \u0443 \u0447\u0430\u0441\u0456, \u043C\u043E\u0436\u0435 \u0432\u0430\u0448\u0430 \u0441\u0445\u0435\u043C\u0430 \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u0430.","Load your preferences success!":"\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F \u0443\u043F\u043E\u0434\u043E\u0431\u0430\u043D\u043D\u044C \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E !","Save preferences successfully!":"\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F \u0443\u043F\u043E\u0434\u043E\u0431\u0430\u043D\u043D\u044C \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E !","Update subckt ok!":"\u043E\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0431\u043B\u043E\u043A\u0430 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E !","Please type a new file name":"\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043D\u0430\u0431\u0435\u0440\u0456\u0442\u044C \u0456\u043C'\u044F \u043D\u043E\u0432\u043E\u0433\u043E \u0444\u0430\u0439\u043B\u0430","Create file failure!":"\u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u0444\u0430\u0439\u043B\u0430 \u043D\u0435 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E!","Schematics and PCBs can't be imported under My Libs folder, please choose a different folder":"\u0421\u0445\u0435\u043C\u0443 \u0456 \u0434\u0440\u0443\u043A\u043E\u0432\u0430\u043D\u0443 \u043F\u043B\u0430\u0442\u0443 \u043D\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0456\u043C\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u0434\u043E \u043F\u0430\u043F\u043A\u0438 My Libs, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043E\u0431\u0435\u0440\u0456\u0442\u044C \u0456\u043D\u0448\u0448\u0443 \u043F\u0430\u043F\u043A\u0443","Libraries to be imported under My Libs folder":"\u0411\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0438 \u0456\u043C\u043F\u043E\u0440\u0442\u043E\u0432\u0430\u043D\u043E \u0434\u043E \u043F\u0430\u043F\u043A\u0438 My Libs","Please choose only the libraries needed":"\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043E\u0431\u0435\u0440\u0456\u0442\u044C \u0442\u0456\u043B\u044C\u043A\u0438 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0456 \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0438","Maximum import is 200 libs at one time!":"\u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0439 \u0456\u043C\u043F\u043E\u0440\u0442\u0443 \u0441\u043A\u043B\u0430\u0434\u0430\u0454 200 \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A \u0437\u0430 \u0440\u0430\u0437!","Import Libraries success":"\u0406\u043C\u043F\u043E\u0440\u0442 \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E","You libraries will be found under the My Libs folder":"\u041F\u043E\u0448\u0443\u043A \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A \u0431\u0443\u0434\u0435 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0438\u0441\u044C \u0443 \u043F\u0430\u043F\u0446\u0456 My Libs","Add to My Libs":"\u0414\u043E\u0434\u0430\u0442\u0438 \u0434\u043E My Libs","No items have been checked!":"\u041D\u0435 \u043E\u0431\u0440\u0430\u043D\u043E \u043F\u0443\u043D\u043A\u0442\u0438 \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0438!","Nothing was found, please create it for yourself":"\u041D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u043E, \u0441\u0442\u0432\u043E\u0440\u0456\u0442\u044C \u0439\u043E\u0433\u043E, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E","Search result":"\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043F\u043E\u0448\u0443\u043A\u0443","At least 3 characters needed":"\u041D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E \u044F\u043A \u043C\u0456\u043D\u0456\u043C\u0443\u043C 3 \u0441\u0438\u043C\u0432\u043E\u043B\u0438","Add to my Favorite Parts":"\u0414\u043E\u0434\u0430\u0442\u0438 \u0434\u043E \u043C\u043E\u0457\u0445 \u043E\u0431\u0440\u0430\u043D\u0438\u0445 \u0431\u043B\u043E\u043A\u0456\u0432","Added it OK. Please find it in your Favorite Parts":"\u0414\u043E\u0434\u0430\u0432\u0430\u043D\u043D\u044F \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E. \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0448\u0443\u043A\u0430\u0439\u0442\u0435 \u0439\u043E\u0433\u043E \u0443 \u0441\u0432\u043E\u0457\u0445 \u043E\u0431\u0440\u0430\u043D\u0438\u0445 \u0431\u043B\u043E\u043A\u0430\u0445","Please select its parent node":"\u043E\u0431\u0435\u0440\u0456\u0442\u044C, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0431\u0430\u0442\u044C\u043A\u0456\u0432\u0441\u044C\u043A\u0438\u0439 \u0432\u0443\u0437\u043E\u043B","Libraries can not be exported as active project pdf.":"\u0411\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0438 \u043D\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0435\u043A\u0441\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u044F\u043A \u0430\u043A\u0442\u0438\u0432\u043D\u0456 \u043F\u0440\u043E\u0435\u043A\u0442\u0438 pdf.","Circuit does not have a GND,":"\u0421\u0445\u0435\u043C\u0430 \u043D\u0435 \u043C\u0430\u0454 \u0432\u0438\u0432\u043E\u0434\u0430 \u0417\u0435\u043C\u043B\u0456 GND,","Circuit does not have a probe,":"\u0441\u0445\u0435\u043C\u0430 \u043D\u0435 \u043C\u0430\u0454 \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043B\u044C\u043D\u0438\u0445 \u0442\u043E\u0447\u043E\u043A,","Make sure your pin numbers are even numbers":"\u041F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0439\u0442\u0435\u0441\u044F, \u0449\u043E \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u0432\u0438\u0432\u043E\u0434\u0456\u0432 \u0454 \u043F\u0430\u0440\u043D\u0438\u043C \u0447\u0438\u0441\u043B\u043E\u043C","Prefix Conflict":"\u041A\u043E\u043D\u0444\u043B\u0456\u043A\u0442 \u043F\u0440\u0435\u0444\u0456\u043A\u0441\u0430","There are some invalid packages, are you sure?":"\u0414\u0435\u044F\u043A\u0456 \u043A\u043E\u0440\u043F\u0443\u0441\u0438 \u043D\u0435\u0432\u0456\u0440\u043D\u0456, \u0412\u0438 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0456?","Invalid Characters, library only allows [0-9a-zA-Z-_]":"\u041D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0456 \u0441\u0438\u043C\u0432\u043E\u043B\u0438, \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u044E\u0442\u044C\u0441\u044F \u0442\u0456\u043B\u044C\u043A\u0438 \u0437 \u0434\u0456\u0430\u043F\u0430\u0437\u043E\u043D\u0443 [0-9a-zA-Z-_]","Annotation success":"\u0410\u043D\u043E\u0442\u0430\u0446\u0456\u044E \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E","If you accept this annotation operation, please save your files. If not, close your files without saving.":"\u042F\u043A\u0449\u043E \u0412\u0438 \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u0454\u0442\u0435 \u0446\u044E \u0430\u043D\u043E\u0442\u0430\u0446\u0456\u044E, \u0442\u043E \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044C, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0432\u0430\u0448 \u0444\u0430\u0439\u043B. \u042F\u043A\u0449\u043E \u0436 \u043D\u0456, \u0442\u043E \u0437\u0430\u043A\u0440\u0438\u0439\u0442\u0435 \u0439\u043E\u0433\u043E \u0431\u0435\u0437 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F.","This file can't be saved under libs project. Please choose other project or create a new project":"\u0426\u0435\u0439 \u0444\u0430\u0439\u043B \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0443 \u044F\u043A\u043E\u0441\u0442\u0456 \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0431\u0456\u0431\u043B\u0456\u043E\u0442\u0435\u043A\u0438, \u043E\u0431\u0435\u0440\u0456\u0442\u044C \u0456\u043D\u0448\u0438\u0439 \u0442\u0438\u043F \u043F\u0440\u043E\u0435\u043A\u0442\u0443, \u0447\u0438 \u0441\u0442\u0432\u043E\u0440\u0456\u0442\u044C \u043D\u043E\u0432\u0438\u0439 \u043F\u0440\u043E\u0435\u043A\u0442.","Your file is unsaved.":"\u0412\u0430\u0448 \u0444\u0430\u0439\u043B \u043D\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043E.","You can close the editor now. Have a good day!":"\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0437\u0430\u0440\u0430\u0437 \u0437\u0430\u043A\u0440\u0438\u0442\u0438 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440 \u0438 \u0441\u043A\u0430\u0437\u0430\u0442\u0438 \u043D\u0430\u043C \u0434\u043E \u043F\u043E\u0431\u0430\u0447\u0435\u043D\u043D\u044F!","Logout Successfully!":"\u0412\u0438\u0445\u0456\u0434 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E","You have unsaved file, please save it or close it":"\u0412\u0438 \u043C\u0430\u0454\u0442\u0435 \u043D\u0435\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0439 \u0444\u0430\u0439\u043B, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044C \u0439\u043E\u0433\u043E, \u0430\u0431\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u043A\u0440\u0438\u0439\u0442\u0435","Please Save your file before the this operation":"\u0417\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044C, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0441\u0432\u0456\u0439 \u0444\u0430\u0439\u043B \u043F\u0435\u0440\u0435\u0434 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F\u043C \u0446\u0456\u0454\u0457 \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0457","Please try again after saving this file.":"\u041F\u043E\u0432\u0442\u043E\u0440\u0456\u0442\u044C \u0437\u043D\u043E\u0432\u0443 \u043F\u0456\u0441\u043B\u044F \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F \u0446\u044C\u043E\u0433\u043E \u0444\u0430\u0439\u043B\u0443.","Connecting to server":"\u041F\u0456\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044F \u0434\u043E \u0441\u0435\u0440\u0432\u0435\u0440\u0443","You will save your file as anonymous file, do you like to create your own project?":"\u0411\u0430\u0436\u0430\u0454\u0442\u0435 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0446\u0435\u0439 \u0444\u0430\u0439\u043B \u0431\u0435\u0437 \u043D\u0430\u0437\u0432\u0438, \u0449\u043E\u0431 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u0439\u043E\u0433\u043E \u0443 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u043C\u0443 \u043F\u0440\u043E\u0435\u043A\u0442\u0456?","Please login before asking for help":"\u0412\u0438\u043A\u043E\u043D\u0430\u0439\u0442\u0435 \u0432\u0445\u0456\u0434, \u043F\u0435\u0440\u0435\u0434 \u0442\u0438\u043C \u044F\u043A \u0437\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u043F\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443","This file has been modified, please save it first!":"\u0426\u0435\u0439 \u0444\u0430\u0439\u043B \u0431\u0443\u043B\u043E \u0437\u043C\u0456\u043D\u0435\u043D\u043E, \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044C \u0439\u043E\u0433\u043E, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430!","Remove this param":"\u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438 \u0446\u0435\u0439 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440","Welcome & Thanks for Joining Us! Do you like to create your own project now?":"\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u043C\u043E \u0456 \u0434\u044F\u043A\u0443\u0454\u043C\u043E, \u0449\u043E \u043F\u0440\u0438\u0454\u0434\u043D\u0430\u043B\u0438\u0441\u044C \u0434\u043E \u043D\u0430\u0441! \u0411\u0430\u0436\u0430\u0454\u0442\u0435 \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u0441\u0432\u0456\u0439 \u0432\u043B\u0430\u0441\u043D\u0438\u0439 \u043F\u0440\u043E\u0435\u043A\u0442 \u043F\u0440\u044F\u043C\u043E \u0437\u0430\u0440\u0430\u0437?","Click on an object to select then click on the canvas to place it":"\u041A\u043B\u0430\u0446\u043D\u0456\u0442\u044C \u043D\u0430 \u043E\u0431'\u0454\u043A\u0442\u0456, \u0449\u043E\u0431 \u043E\u0431\u0440\u0430\u0442\u0438 \u0439\u043E\u0433\u043E, \u0456 \u043A\u043B\u0430\u0446\u043D\u0456\u0442\u044C \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u043C\u0443 \u043C\u0456\u0441\u0446\u0456, \u0449\u043E\u0431 \u0440\u043E\u0437\u043C\u0456\u0441\u0442\u0438\u0442\u0438 \u0439\u043E\u0433\u043E \u0442\u0430\u043C","Undo/Redo temporary error":"\u0422\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u0430 \u043F\u043E\u043C\u0438\u043B\u043A\u0430 \u0412\u0456\u0434\u043C\u0456\u043D\u0438/\u041F\u043E\u0432\u0442\u043E\u0440\u0443","We are sorry but EasyEDA is exhibiting an unpredictable error in the undo/redo process. This problem will be fixed soon but in the meanwhile it is safe to continue working on your design.":"\u041D\u0430\u0436\u0430\u043B\u044C, \u0443 EasyEDA \u0437'\u044F\u0432\u043B\u044F\u0454\u0442\u044C\u0441\u044F \u043D\u0435\u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0435\u043D\u0430 \u043F\u043E\u043C\u0438\u043B\u043A\u0430 \u043F\u0440\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u0456 \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0439 \u0412\u0456\u0434\u043C\u0456\u043D\u0438/\u041F\u043E\u0432\u0442\u043E\u0440\u0443. \u0426\u044E \u043F\u043E\u043C\u0438\u043B\u043A\u0443 \u0431\u0443\u0434\u0435 \u0432\u0438\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E \u0443 \u043D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0438\u0439 \u0447\u0430\u0441, \u0430 \u0440\u043E\u0431\u043E\u0442\u0443 \u043D\u0430\u0434 \u0432\u0430\u0448\u043E\u044E \u0440\u043E\u0437\u0440\u043E\u0431\u043A\u043E\u044E \u0446\u0456\u043B\u043A\u043E\u043C \u043C\u043E\u0436\u043B\u0438\u0432\u043E \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u0442\u0438.","Please click the below help button to find out how to fix this problem.":"\u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443, \u0449\u043E \u043D\u0438\u0436\u0447\u0435 \u043A\u043D\u043E\u043F\u043A\u0438 \u0414\u043E\u043F\u043E\u043C\u043E\u0433\u0430, \u0434\u043B\u044F \u0443\u0441\u0443\u043D\u0435\u043D\u043D\u044F \u0446\u0456\u0454\u0457 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0438.","Please create a board outline! Click the help button to find out how to create a board outline.":"\u0421\u0442\u0432\u043E\u0440\u0456\u0442\u044C, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043A\u043E\u043D\u0442\u0443\u0440\u0438 \u043F\u043B\u0430\u0442\u0438! \u041A\u043B\u0430\u0446\u043D\u0456\u0442\u044C \u043D\u0430 \u043A\u043D\u043E\u043F\u0446\u0456 \u0414\u043E\u043F\u043E\u043C\u043E\u0433\u0430, \u0449\u043E\u0431 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F, \u044F\u043A \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438 \u043A\u043E\u043D\u0442\u0443\u0440\u0438 \u043F\u043B\u0430\u0442\u0438.",Skip:"\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0438","\u2190 Back":"\u2190 \u041F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u0456\u0439","Next \u2192":"\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0439 \u2192","This is user management menu.":"\u0426\u0435 \u043C\u0435\u043D\u044E \u0443\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0435\u043C.","This is super menu.":"\u0426\u0435 \u0433\u043E\u043B\u043E\u0432\u043D\u0435 \u043C\u0435\u043D\u044E.","This is toolbar.":"\u0426\u0435 \u043F\u0430\u043D\u0435\u043B\u044C \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432.","This is config menu button.":"\u0426\u0435 \u043A\u043D\u043E\u043F\u043A\u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043C\u0435\u043D\u044E.","This is share button.":"\u0426\u0435 \u043A\u043D\u043E\u043F\u043A\u0438 \u043D\u0430\u0434\u0430\u043D\u043D\u044F.","This is document management menu.":"\u0426\u0435 \u043C\u0435\u043D\u044E \u0443\u043F\u0440\u0430\u0432\u043B\u0456\u043D\u043D\u044F \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u043C.","Show or hide your toolbar at here.":"\u0421\u0445\u043E\u0432\u0430\u0439\u0442\u0435 \u0430\u0431\u043E \u043F\u043E\u043A\u0430\u0436\u0456\u0442\u044C \u043F\u0430\u043D\u0435\u043B\u044C \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0456\u0432 \u0437 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0446\u044C\u043E\u0433\u043E.","Show or hide your left sidebar at here.":"\u0421\u0445\u043E\u0432\u0430\u0439\u0442\u0435 \u0430\u0431\u043E \u043F\u043E\u043A\u0430\u0436\u0456\u0442\u044C \u043B\u0456\u0432\u0443 \u0431\u043E\u043A\u043E\u0432\u0443 \u043F\u0430\u043D\u0435\u043B\u044C \u0437 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0446\u044C\u043E\u0433\u043E.","Show or hide your right sidebar at here.":"\u0421\u0445\u043E\u0432\u0430\u0439\u0442\u0435 \u0430\u0431\u043E \u043F\u043E\u043A\u0430\u0436\u0456\u0442\u044C \u043F\u0440\u0430\u0432\u0443 \u0431\u043E\u043A\u043E\u0432\u0443 \u043F\u0430\u043D\u0435\u043B\u044C \u0437 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0446\u044C\u043E\u0433\u043E.","Passive Components":"\u041F\u0430\u0441\u0438\u0432\u043D\u0456 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438","Power Supply":"\u0414\u0436\u0435\u0440\u0435\u043B\u0430 \u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044F",Diodes:"\u0414\u0456\u043E\u0434\u0438",Regulator:"\u0421\u0442\u0430\u0431\u0456\u043B\u0456\u0437\u0430\u0442\u043E\u0440\u0438",Transistor:"\u0422\u0440\u0430\u043D\u0437\u0438\u0441\u0442\u043E\u0440\u0438",Transformers:"\u0422\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u0438",Gates:"\u041B\u043E\u0433\u0456\u0447\u043D\u0456 \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0438","Vacuum Tubes":"\u0415\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u0456 \u043B\u0430\u043C\u043F\u0438",Switch:"\u0412\u0438\u043C\u0438\u043A\u0430\u0447\u0456",Relay:"\u0420\u0435\u043B\u0435","Capacitor(US)":"\u041A\u043E\u043D\u0434\u0435\u043D\u0441\u0430\u0442\u043E\u0440 (\u0421\u0428\u0410)","Capacitor(EU)":"\u