E\u0441\u0442\u043E \u0445\u043E\u0442\u0438\u0442\u0435 \u0441\u043E\u0437\u0434\u0430\u0442\u044C symbol","need login":"\u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0432\u043E\u0439\u0442\u0438","bad password":"\u043D\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043F\u0430\u0440\u043E\u043B\u044C","We cant find your username or your email,please check it!":"\u041C\u044B \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0438 \u043D\u0430\u0439\u0442\u0438 \u0432\u0430\u0448\u0435 \u0438\u043C\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0438\u043B\u0438 \u044D\u043B. \u043F\u043E\u0447\u0442\u0443, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0438\u0445!","Make sure your uploaded file size is less than 3MB !":"\u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u0440\u0430\u0437\u043C\u0435\u0440 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u0433\u043E \u0444\u0430\u0439\u043B\u0430 \u043D\u0435 \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442 3\u041C\u0411!","bad file type":"\u043F\u043B\u043E\u0445\u043E\u0439 \u0442\u0438\u043F \u0444\u0430\u0439\u043B\u0430","Empty file or bad file type, ensure your file is Eagle 6.0+":"\u041F\u0443\u0441\u0442\u043E\u0439 \u0444\u0430\u0439\u043B \u0438\u043B\u0438 \u043F\u043B\u043E\u0445\u043E\u0439 \u0442\u0438\u043F \u0444\u0430\u0439\u043B\u0430, \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u0432\u0430\u0448 \u0444\u0430\u0439\u043B \u0441\u043E\u0437\u0434\u0430\u043D \u0432 Eagle 6.0+","This operation not supported on demo account":"\u042D\u0442\u0430 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F \u043D\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0434\u0435\u043C\u043E \u0430\u043A\u043A\u0430\u0443\u043D\u0442\u0435","Can not share this file that under a public project, please set the active project to public!":"\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0444\u0430\u0439\u043B\u043E\u043C \u0438\u0437 \u043F\u0440\u0438\u0432\u0430\u0442\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0430, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u044B\u043C!","Login Failed Too many attempts. If you forgot your password, please {0}reset your password{1} or send an email to support@easyeda.com":"\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u043F\u043E\u043F\u044B\u0442\u043E\u043A \u0432\u043E\u0439\u0442\u0438. \u0415\u0441\u043B\u0438 \u0432\u044B \u0437\u0430\u0431\u044B\u043B\u0438 \u0441\u0432\u043E\u0439 \u043F\u0430\u0440\u043E\u043B\u044C, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, {0}\u0441\u0431\u0440\u043E\u0441\u044C\u0442\u0435 \u0435\u0433\u043E{1} \u0438\u043B\u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u043F\u0438\u0441\u044C\u043C\u043E \u043D\u0430 support@easyeda.com","Common Buttons Setting":"\u041E\u0431\u0449\u0438\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043A\u043B\u0430\u0432\u0438\u0448","Show/Hide":"\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C/\u0421\u043A\u0440\u044B\u0442\u044C","Move Up":"\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0432\u044B\u0448\u0435","Move Down":"\u041F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u043D\u0438\u0436\u0435","Reset All":"\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u0441\u0451","Find Libraries...":"\u041D\u0430\u0439\u0442\u0438 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438...","Place Pin":"\u0420\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\